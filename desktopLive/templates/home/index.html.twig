                <div style="margin:2rem 0; background:#F9FAFB; border-radius:12px; padding:2rem; text-align:center;">
                    <h3 style="font-size:1.3rem; font-weight:700; margin-bottom:1rem;">Fidélité</h3>
                    <p>Point de fidélité après achat.<br>Les points deviennent des remises !</p>
                    <div style="font-size:1.1rem; color:#10B981; font-weight:700; margin-top:1rem;">
                        Points cumulés : {{ user.fidelity|default(0) }}
                    </div>
                </div>
                <script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filter-form');
    const productList = document.getElementById('product-list');

    // --- Filtrage local ---
    if (filterForm && productList) {
        filterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const cat = document.getElementById('cat').value.toLowerCase();
            const minprice = parseFloat(document.getElementById('minprice').value) || 0;
            const maxprice = parseFloat(document.getElementById('maxprice').value) || Infinity;
            productList.querySelectorAll('.product-card').forEach(function(card) {
                const cardCat = card.getAttribute('data-cat').toLowerCase();
                const cardPrice = parseFloat(card.getAttribute('data-price')) || 0;
                let show = true;
                if (cat && cardCat !== cat) show = false;
                if (cardPrice < minprice) show = false;
                if (cardPrice > maxprice) show = false;
                card.style.display = show ? '' : 'none';
            });
            productList.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        // --- Filtrage AJAX ---
        filterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData).toString();
            fetch(window.location.pathname + '?' + params, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const newList = tempDiv.querySelector('#product-list');
                if (newList) {
                    productList.innerHTML = newList.innerHTML;
                    productList.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    }

    // --- Favoris et Panier dynamique ---
    if (productList) {
        productList.addEventListener('click', function(e) {
            // Favoris
            if (e.target.closest('.fav-btn')) {
                e.preventDefault();
                const btn = e.target.closest('.fav-btn');
                const icon = btn.querySelector('i');
                const isFavorite = btn.classList.contains('active');
                const itemId = btn.dataset.id;
                const url = isFavorite ? '/client/favorite/remove-all-sizes/' + itemId : '/client/favorite/toggle-all-sizes/' + itemId;
                const favBadge = document.querySelector('.favorites-count');
                let favCount = parseInt(favBadge.textContent) || 0;

                fetch(url, {
                    method: 'POST'
                })
                .then(res => {
                    if (!res.ok) throw new Error("Erreur serveur: " + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data.success) {
                        console.error('Erreur:', data.message);
                        return;
                    }

                    // Toggle visual
                    btn.classList.toggle('active');
                    icon.classList.toggle('fas');
                    icon.classList.toggle('far');

                    // Update count
                    favBadge.textContent = isFavorite ? favCount - data.count : favCount + data.count;

                    // Add/remove favori span
                    const card = btn.closest('.product-card');
                    if (isFavorite) {
                        const favSpan = card.querySelector('.favori-span');
                        if (favSpan) favSpan.remove();
                        btn.setAttribute('title', 'Ajouter aux favoris');
                    } else {
                        const favSpan = document.createElement('span');
                        favSpan.classList.add('favori-span');
                        favSpan.style = "position:absolute; top:18px; right:18px; background:#FFD600; color:#231f20; border-radius:50%; padding:6px 10px; font-weight:700; font-size:13px;";
                        favSpan.textContent = "Favori";
                        card.appendChild(favSpan);
                        btn.setAttribute('title', 'Retirer des favoris');
                    }

                    console.log("Favori mis à jour :", data);
                })
                .catch(err => console.error(err));
            }

            // Panier dynamique
            if (e.target.closest('.cart-btn')) {
                e.preventDefault();
                const btn = e.target.closest('.cart-btn');
                const isInCart = btn.classList.contains('in-cart');
                const itemId = btn.dataset.id;
                const url = isInCart ? '/client/remove-cart/' + itemId : '/client/add-cart/' + itemId;
                const cartBadge = document.querySelector('.cart-count');
                let cartCount = parseInt(cartBadge.textContent) || 0;

                fetch(url, {
                    method: 'POST'
                })
                .then(res => {
                    if (!res.ok) throw new Error("Erreur serveur");
                    return res.text();
                })
                .then(data => {
                    btn.classList.toggle('in-cart');
                    const card = btn.closest('.product-card');
                    if (isInCart) {
                        // Remove
                        const panierSpan = card.querySelector('.panier-span');
                        if (panierSpan) panierSpan.remove();
                        btn.setAttribute('title', 'Ajouter au panier');
                        cartBadge.textContent = cartCount - 1;
                        console.log("Produit retiré du panier :", data);
                    } else {
                        // Add
                        btn.classList.add('added');
                        setTimeout(() => {
                            btn.classList.remove('added');
                            const panierSpan = document.createElement('span');
                            panierSpan.classList.add('panier-span');
                            panierSpan.style = "position:absolute; top:48px; right:18px; background:#4F46E5; color:#fff; border-radius:50%; padding:6px 10px; font-weight:700; font-size:13px;";
                            panierSpan.textContent = "Panier";
                            card.appendChild(panierSpan);
                            btn.setAttribute('title', 'Retirer du panier');
                        }, 800);
                        cartBadge.textContent = cartCount + 1;
                        console.log("Produit ajouté au panier :", data);
                    }
                })
                .catch(err => console.error(err));
            }
        });
    }
});
                </script>
            </section>
