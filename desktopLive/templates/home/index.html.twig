    <!-- JavaScript (conservé de votre code original) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('filter-form');
            const productList = document.getElementById('product-list');
            
            // Filtrage local
            if (filterForm && productList) {
                filterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const cat = document.getElementById('cat').value.toLowerCase();
                    const minprice = parseFloat(document.getElementById('minprice').value) || 0;
                    const maxprice = parseFloat(document.getElementById('maxprice').value) || Infinity;
                    
                    productList.querySelectorAll('.product-card').forEach(function(card) {
                        const cardCat = card.getAttribute('data-cat').toLowerCase();
                        const cardPrice = parseFloat(card.getAttribute('data-price')) || 0;
                        let show = true;
                        
                        if (cat && cardCat !== cat) show = false;
                        if (cardPrice < minprice) show = false;
                        if (cardPrice > maxprice) show = false;
                        
                        card.style.display = show ? '' : 'none';
                    });
                    
                    productList.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });

                // Filtrage AJAX
                filterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(filterForm);
                    const params = new URLSearchParams(formData).toString();
                    
                    fetch(window.location.pathname + '?' + params, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(res => res.text())
                    .then(html => {
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        const newList = tempDiv.querySelector('#product-list');
                        if (newList) {
                            productList.innerHTML = newList.innerHTML;
                            productList.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    });
                });
            }

            // Gestion des favoris et panier (votre code original conservé)
            if (productList) {
                productList.addEventListener('click', function(e) {
                    // Gestion des favoris
                    if (e.target.closest('.fav-btn')) {
                        e.preventDefault();
                        const btn = e.target.closest('.fav-btn');
                        const itemId = btn.dataset.id;
                        const isFavorite = btn.classList.contains('active');
                        const url = isFavorite ? `/client/favorite/remove-all-sizes/${itemId}` : `/client/favorite/toggle-all-sizes/${itemId}`;
                        const favBadge = document.querySelector('.stat-favorites .stat-value');
                        let favCount = parseInt(favBadge.textContent) || 0;

                        fetch(url, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(res => {
                            if (!res.ok) throw new Error(`Erreur serveur: ${res.status}`);
                            return res.json();
                        })
                        .then(data => {
                            if (!data.success) return;

                            const card = btn.closest('.product-card');
                            const icon = btn.querySelector('i');
                            const badge = card.querySelector('.badge-favorite');

                            // Mise à jour visuelle
                            btn.classList.toggle('active');
                            icon.classList.toggle('fas');
                            icon.classList.toggle('far');
                            favBadge.textContent = isFavorite ? favCount - 1 : favCount + 1;

                            if (isFavorite) {
                                if (badge) badge.remove();
                                btn.setAttribute('title', 'Ajouter aux favoris');
                            } else {
                                const newBadge = document.createElement('div');
                                newBadge.className = 'badge badge-favorite';
                                newBadge.textContent = 'Favori';
                                card.querySelector('.product-badges').appendChild(newBadge);
                                btn.setAttribute('title', 'Retirer des favoris');
                            }
                        })
                        .catch(err => {
                            console.error('Erreur:', err);
                            alert('Une erreur est survenue');
                        });
                    }

                    // Gestion du panier
                    if (e.target.closest('.cart-btn')) {
                        e.preventDefault();
                        const btn = e.target.closest('.cart-btn');
                        const isInCart = btn.classList.contains('added');
                        const itemId = btn.dataset.id;
                        const url = isInCart ? '/client/remove-cart/' + itemId : '/client/add-cart/' + itemId;
                        const cartBadge = document.querySelector('.stat-cart .stat-value');
                        let cartCount = parseInt(cartBadge.textContent) || 0;
                        
                        fetch(url, { method: 'POST' })
                        .then(res => {
                            if (!res.ok) throw new Error("Erreur serveur");
                            return res.text();
                        })
                        .then(data => {
                            btn.classList.toggle('added');
                            const card = btn.closest('.product-card');
                            const badge = card.querySelector('.badge-cart');
                            
                            if (isInCart) {
                                if (badge) badge.remove();
                                btn.innerHTML = '<i class="fas fa-shopping-basket"></i> Ajouter';
                                btn.setAttribute('title', 'Ajouter au panier');
                                cartBadge.textContent = cartCount - 1;
                            } else {
                                btn.classList.add('added');
                                setTimeout(() => {
                                    const newBadge = document.createElement('div');
                                    newBadge.className = 'badge badge-cart';
                                    newBadge.textContent = 'Panier';
                                    card.querySelector('.product-badges').appendChild(newBadge);
                                    btn.innerHTML = '<i class="fas fa-shopping-basket"></i> Retirer';
                                    btn.setAttribute('title', 'Retirer du panier');
                                }, 400);
                                cartBadge.textContent = cartCount + 1;
                            }
                        })
                        .catch(err => console.error(err));
                    }
                });
            
                // --- Rating interaction: hover + click to send rating ---
                document.querySelectorAll('.rating-stars').forEach(starsWrap => {
                    const stars = Array.from(starsWrap.querySelectorAll('i'));
                    const productCard = starsWrap.closest('.product-card');
                    const productId = productCard ? productCard.getAttribute('data-id') || productCard.dataset.id : null;

                    // if productId not present try reading from template variable (data attribute not set by default)
                    // We will fallback to using a data-product-id attribute if available.
                    if (!productId) {
                        // try set from inner template if developer provided one
                        productCard && (productCard.dataset.id = productCard.dataset.id || productCard.getAttribute('data-id'));
                    }

                    let currentRating = 0;

                    function highlight(n) {
                        stars.forEach((s, idx) => {
                            if (idx < n) {
                                s.classList.remove('far'); s.classList.add('fas');
                            } else {
                                s.classList.remove('fas'); s.classList.add('far');
                            }
                        });
                    }

                    // mouseover preview
                    stars.forEach((star, idx) => {
                        star.style.cursor = 'pointer';
                        star.addEventListener('mouseenter', () => highlight(idx + 1));
                        star.addEventListener('mouseleave', () => highlight(currentRating));

                        star.addEventListener('click', async (e) => {
                            e.preventDefault();
                            const selected = idx + 1;
                            // optimistic UI
                            currentRating = selected;
                            highlight(currentRating);

                            // find rating-count span
                            const countEl = productCard.querySelector('.rating-count');

                            try {
                                const resp = await fetch('/client/product/rate', {
                                    method: 'POST',
                                    credentials: 'same-origin',
                                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                                    body: JSON.stringify({ productId: productCard.dataset.id || productCard.getAttribute('data-id'), rating: selected })
                                });

                                // Read response body (text) and try to parse JSON for better error reporting
                                let data = null;
                                try {
                                    const text = await resp.text();
                                    try { data = text ? JSON.parse(text) : null; } catch (e) { data = text; }
                                } catch (e) {
                                    console.error('Failed to read response body', e);
                                }

                                if (!resp.ok) {
                                    console.error('Server error response:', resp.status, data);
                                    const msg = data && data.message ? data.message : ('HTTP ' + resp.status);
                                    throw new Error(msg);
                                }

                                if (data && data.success) {
                                    // update displayed average rating and review_count if provided
                                    if (typeof data.newRating !== 'undefined') {
                                        // update stars according to rounded newRating
                                        const newR = Math.round(data.newRating);
                                        currentRating = newR;
                                        highlight(currentRating);
                                    }
                                    if (data.review_count && countEl) {
                                        countEl.textContent = `(${data.review_count})`;
                                    }
                                } else {
                                    throw new Error(data && data.message ? data.message : 'Erreur serveur');
                                }
                            } catch (err) {
                                console.error('Rating error:', err);
                                // revert UI (optional)
                                highlight(currentRating);
                                // show basic alert
                                alert('Impossible d\'enregistrer la note, réessayez.');
                            }
                        });
                    });
                });
            }
        });
    </script>
</body>
