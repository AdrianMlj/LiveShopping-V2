{% if sale is defined and sale %}
<div class="invoice-container">
  <div class="invoice-header">
    <div class="invoice-party invoice-client">
      <h4 class="invoice-title">Facturé à</h4>
      <p class="invoice-details">
        <strong>{{ sale.commande.client.username|default('N/A') }}</strong><br>
        {{ sale.commande.client.email|default('N/A') }}<br>
        {{ sale.commande.client.contact|default('N/A') }}<br>
        {{ sale.commande.client.address|default('') }}{% if sale.commande.client.country %}, {{ sale.commande.client.country }}{% endif %}
      </p>
    </div>
    <div class="invoice-party invoice-seller">
      <h4 class="invoice-title">Vendu par</h4>
      <p class="invoice-details">
        <strong>{{ sale.commande.seller.username|default('N/A') }}</strong><br>
        {{ sale.commande.seller.email|default('N/A') }}<br>
        {{ sale.commande.seller.contact|default('N/A') }}<br>
        Vendeur certifié
      </p>
    </div>
  </div>

  <div class="invoice-status-section">
    <span class="status-badge status-{{ sale.commande.state.nameState|lower|replace({' ': '-'}) }}">{{ sale.commande.state.nameState }}</span>
    {% if sale.isPaid %}
      <span class="status-badge paid">Payé</span>
    {% else %}
      <span class="status-badge pending">En attente de paiement</span>
    {% endif %}
  </div>

  <div class="invoice-table-wrapper">
    <table class="invoice-table">
      <thead>
        <tr>
          <th style="width: 60px;">Image</th>
          <th>Produit</th>
          <th>Taille</th>
          <th>Qté</th>
          <th>Prix unit.</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {% set total = 0 %}
        {% for detail in sale.commande.details %}
          {% set lineTotal = detail.quantity * detail.price %}
          {% set total = total + lineTotal %}
          {% set item = detail.itemSize.item %}
          {% set displayImage = null %}
          {% if item.images %}
            {% set displayImage = item.images %}
          {% endif %}
          <tr>
            <td class="product-image-cell">
              {% if displayImage %}
                <img src="/Uploads/{{ displayImage }}" alt="{{ item.nameItem }}" class="product-thumbnail" loading="lazy">
              {% else %}
                <div class="product-thumbnail-placeholder">
                  <i class="fa-solid fa-image"></i>
                </div>
              {% endif %}
            </td>
            <td class="product-name-cell">
              <strong>{{ item.nameItem }}</strong>
            </td>
            <td>{{ detail.itemSize.valueSize }}</td>
            <td class="quantity-cell">{{ detail.quantity }}</td>
            <td>{{ detail.price|number_format(0, ' ', ' ') }} Ar</td>
            <td class="total-cell"><strong>{{ lineTotal|number_format(0, ' ', ' ') }} Ar</strong></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="invoice-footer">
  <div class="total-amount">
      <h4>Total TTC : {{ (total * 1.2)|number_format(0, ' ', ' ') }} Ar</h4>
    </div>
  </div>
</div>

<style>
:root {
  --primary: #6366f1;
  --primary-dark: #4f46e5;
  --primary-light: #a5b4fc;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --dark: #1f2937;
  --darker: #111827;
  --light: #f8fafc;
  --gray: #6b7280;
  --gray-light: #9ca3af;
  --border: #e5e7eb;
  --gradient-primary: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --gradient-dark: linear-gradient(135deg, #1f2937 0%, #374151 100%);
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --radius: 12px;
  --radius-sm: 8px;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.invoice-container {
  max-width: 900px;
  margin: 0;
  padding: 1.25rem;
  background: var(--light);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  font-family: 'Inter', sans-serif;
  color: var(--dark);
  transition: var(--transition);
  max-height: 85vh;
  overflow-y: auto;
}

.invoice-header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.invoice-party {
  padding: 1rem;
  background: white;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
}

.invoice-party:hover {
  box-shadow: var(--shadow-md);
}

.invoice-title {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--primary);
}

.invoice-details {
  line-height: 1.5;
  color: var(--gray);
  font-size: 0.875rem;
}

.invoice-details strong {
  color: var(--dark);
}

.invoice-status-section {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
  align-items: center;
}

.status-badge {
  padding: 0.4rem 0.85rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  transition: var(--transition);
}

.status-badge:hover {
  transform: scale(1.05);
}

.status-badge.info {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.status-badge.paid {
  background: #d1fae5;
  color: var(--success);
}

.status-badge.pending {
  background: #fef3c7;
  color: var(--warning);
}

.invoice-table-wrapper {
  overflow-x: auto;
  margin-bottom: 1.25rem;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  background: white;
}

.invoice-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.invoice-table th {
  background: var(--light);
  color: var(--dark);
  font-weight: 600;
  text-align: left;
  padding: 0.75rem;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
}

.invoice-table td {
  padding: 0.75rem;
  border-top: 1px solid var(--border);
  color: var(--gray);
  font-size: 0.875rem;
  vertical-align: middle;
}

.invoice-table tr:last-child td {
  border-bottom: none;
}

.invoice-table th:first-child, .invoice-table td:first-child {
  border-top-left-radius: var(--radius-sm);
  border-bottom-left-radius: var(--radius-sm);
}

.invoice-table th:last-child, .invoice-table td:last-child {
  border-top-right-radius: var(--radius-sm);
  border-bottom-right-radius: var(--radius-sm);
}

/* Product image styles */
.product-image-cell {
  padding: 0.5rem !important;
  text-align: center;
}

.product-thumbnail {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  border: 2px solid var(--border);
  transition: var(--transition);
}

.product-thumbnail:hover {
  transform: scale(1.1);
  border-color: var(--primary);
  box-shadow: var(--shadow-md);
}

.product-thumbnail-placeholder {
  width: 50px;
  height: 50px;
  background: var(--light);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-light);
  border: 2px solid var(--border);
}

.product-thumbnail-placeholder i {
  font-size: 1.25rem;
}

.product-name-cell {
  font-weight: 500;
  color: var(--dark);
}

.product-name-cell strong {
  color: var(--dark);
  font-size: 0.9rem;
}

.quantity-cell {
  text-align: center;
  font-weight: 600;
  color: var(--primary);
}

.total-cell {
  text-align: right;
  font-weight: 600;
  color: var(--success);
}

.invoice-footer {
  display: flex;
  justify-content: flex-end;
  padding: 1rem 1.25rem;
  background: white;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  margin-top: 0.75rem;
}

.total-amount h4 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--success);
}

@media (max-width: 768px) {
  .invoice-container {
    padding: 1rem;
    max-height: 90vh;
  }

  .invoice-header {
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .invoice-status-section {
    justify-content: flex-start;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .invoice-table th, .invoice-table td {
    padding: 0.5rem;
    font-size: 0.8rem;
  }

  .product-thumbnail {
    width: 40px;
    height: 40px;
  }

  .product-thumbnail-placeholder {
    width: 40px;
    height: 40px;
  }
}

@media print {
  .invoice-container {
    box-shadow: none;
    border: none;
    max-height: none;
    overflow: visible;
  }

  .invoice-party {
    box-shadow: none;
  }

  .invoice-table-wrapper {
    box-shadow: none;
  }

  .invoice-footer {
    box-shadow: none;
  }
}
</style>
{% else %}
<div class="error-message">
  <p>Erreur : Les données de la commande ne sont pas disponibles.</p>
</div>
<style>
.error-message {
  padding: 2rem;
  text-align: center;
  color: var(--danger);
}
</style>
{% endif %}
