<div class="invoice-container">
  <div class="invoice-infos">
    <div class="client">
      <h4>Facturé à</h4>
      <p>
        <strong>{{ sale.commande.client.username }}</strong><br>
        {{ sale.commande.client.email }}<br>
        {{ sale.commande.client.contact }}<br>
        {{ sale.commande.client.address }}, {{ sale.commande.client.country }}
      </p>
    </div>
    <div class="seller">
      <h4>Vendu par</h4>
      <p>
        <strong>{{ sale.commande.seller.username }}</strong><br>
        {{ sale.commande.seller.email }}<br>
        {{ sale.commande.seller.contact }}<br>
        Vendeur certifié
      </p>
    </div>
  </div>

  <div class="invoice-status">
    <span class="badge info">{{ sale.commande.state.nameState }}</span>
    {% if sale.isPaid %}
      <span class="badge success">Payé</span>
    {% else %}
      <span class="badge warning">En attente de paiement</span>
      <div style="margin-top:10px;">
        <button id="markPaidBtn" class="historique-button" style="padding:8px 12px;">
          <i class="fas fa-hand-holding-usd"></i>
          Marquer payé (livreur)
        </button>
      </div>
    {% endif %}
  </div>

  <div class="invoice-table-container">
    <table class="invoice-table">
      <thead>
        <tr>
          <th>Produit</th>
          <th>Taille</th>
          <th>Quantité</th>
          <th>Prix unitaire</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {% set total = 0 %}
        {% for detail in sale.commande.details %}
          {% set lineTotal = detail.quantity * detail.price %}
          {% set total = total + lineTotal %}
          <tr>
            <td>{{ detail.itemSize.item.nameItem }}</td>
            <td>{{ detail.itemSize.valueSize }}</td>
            <td>{{ detail.quantity }}</td>
            <td>{{ detail.price|number_format(2, ',', ' ') }} €</td>
            <td>{{ lineTotal|number_format(2, ',', ' ') }} €</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="invoice-totals">
    <h4>Total TTC : {{ (total * 1.2)|number_format(2, ',', ' ') }} €</h4>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const btn = document.getElementById('markPaidBtn');
  if (!btn) return;
  btn.addEventListener('click', async (e) => {
    e.preventDefault();
    // Try to find sale id from surrounding modal context
    const modal = document.getElementById('saleDetailsModal');
    const row = document.querySelector('.clickable-row[data-sale-id]');
    const saleId = window.currentSaleId || (row ? row.dataset.saleId : null);
    if (!saleId) { alert('Vente inconnue'); return; }
    try {
      const form = new FormData();
      form.append('sale_id', saleId);
      const res = await fetch('/client/history/mark-paid', { method: 'POST', body: form });
      const data = await res.json();
      if (data && data.success) {
        alert('Paiement enregistré');
        location.reload();
      } else {
        alert(data.message || 'Erreur paiement');
      }
    } catch {
      alert('Erreur réseau');
    }
  });
});
</script>

