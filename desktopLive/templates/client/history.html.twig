{% include 'components/navbarClient.html.twig' %}

{% block content %}
<div class="historique-container">
  <div class="historique-filter-card">
    <form method="get" class="historique-filter-grid">
      <div class="historique-filter-group">
        <label for="date_start" class="historique-filter-label">
          <i class="fas fa-calendar-alt"></i>
          Date début
        </label>
        <input type="date" name="date_start" id="date_start" class="historique-input"
               value="{{ app.request.query.get('date_start') }}">
      </div>

      <div class="historique-filter-group">
        <label for="date_end" class="historique-filter-label">
          <i class="fas fa-calendar-alt"></i>
          Date fin
        </label>
        <input type="date" name="date_end" id="date_end" class="historique-input"
               value="{{ app.request.query.get('date_end') }}">
      </div>

      <div class="historique-filter-group">
        <label for="state" class="historique-filter-label">
          <i class="fas fa-tag"></i>
          État commande
        </label>
        <select name="state" id="state" class="historique-input">
          <option value="">-- Tous --</option>
          {% for state in states %}
            <option value="{{ state.id }}" {{ app.request.query.get('state') == state.id ? 'selected' }}>
              {{ state.nameState }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="historique-filter-group">
        <label for="is_paid" class="historique-filter-label">
          <i class="fas fa-credit-card"></i>
          Paiement
        </label>
        <select name="is_paid" id="is_paid" class="historique-input">
          <option value="">-- Tous --</option>
          <option value="1" {{ app.request.query.get('is_paid') == '1' ? 'selected' }}>Payé</option>
          <option value="0" {{ app.request.query.get('is_paid') == '0' ? 'selected' }}>Non payé</option>
        </select>
      </div>

      <div class="historique-filter-actions">
        <button type="submit" class="historique-button">
          <i class="fas fa-search"></i>
          Filtrer
        </button>
      </div>
    </form>
  </div>

  <div class="historique-table-section">
    <div class="historique-table-header">
      <h3 class="historique-table-title">
        <i class="fas fa-receipt"></i>
        Historique de mes achats
      </h3>
    </div>

    <div class="historique-table-container">
      <table class="historique-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Vendeur</th>
            <th>État</th>
            <th>Montant total</th>
            <th>Paiement</th>
          </tr>
        </thead>
        <tbody>
          {% for sale in sales %}
            {% set total = 0 %}
            {% for detail in sale.commande.details %}
              {% set total = total + (detail.quantity * detail.price) %}
            {% endfor %}

            <tr class="clickable-row" data-sale-id="{{ sale.id }}">
              <td>{{ sale.saleDate|date('d/m/Y H:i') }}</td>
              <td>{{ sale.commande.seller ? sale.commande.seller.getUsername() : '-' }}</td>
              <td>{{ sale.commande.state.nameState }}</td>
              <td class="historique-amount">{{ total|number_format(2, ',', ' ') }} €</td>
              <td>
                {% if sale.isPaid %}
                  <span class="historique-badge historique-badge-success">Payé</span>
                {% else %}
                  <span class="historique-badge historique-badge-danger">Non payé</span>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="historique-empty">
                <i class="fas fa-receipt no-conversation-icon"></i>
                Aucun achat trouvé.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="saleDetailsModal" class="custom-modal" style="display: none;">
  <div class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h5>Détails de l'achat</h5>
        <div>
          <button type="button" id="markPaidBtn" class="export-btn" style="background: var(--success); margin-right: 8px;">
            <i class="fas fa-check"></i> Marquer payé (livreur)
          </button>
          <button type="button" id="exportPDF" class="export-btn">
            <i class="fas fa-download"></i> Télécharger la facture
          </button>
          <button type="button" class="close-btn" id="closeModal">&times;</button>
        </div>
      </div>
      <div class="modal-body" id="saleDetailsContent"></div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Animation de chargement de la page (inspiré de messages)
  document.querySelector('.historique-container').classList.add('loaded');

  const modal = document.getElementById('saleDetailsModal');
  const closeBtn = document.getElementById('closeModal');
  const modalContent = document.getElementById('saleDetailsContent');
  let currentSaleId = null;

  function openModal() {
    modal.style.display = 'block';
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('active');
    setTimeout(() => {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
    }, 300); // Durée de l'animation
  }

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'block') closeModal(); });

  document.querySelectorAll('.clickable-row').forEach(row => {
    row.addEventListener('click', () => {
      const saleId = row.dataset.saleId;
      currentSaleId = saleId;
      fetch(`/client/history/details?sale_id=${saleId}`)
        .then(r => r.json())
        .then(data => {
          if (data.html) { 
            modalContent.innerHTML = data.html; 
            openModal(); 
          } else if (data.error) { alert(data.error); }
        })
        .catch(() => alert('Erreur de chargement'));
    });
  });

  // Marquer payé (comme dans votre code)
  const markPaidBtn = document.getElementById('markPaidBtn');
  if (markPaidBtn) {
    markPaidBtn.addEventListener('click', async () => {
      if (!currentSaleId) { alert('Sélectionnez une commande'); return; }
      if (!confirm('Confirmer le paiement au livreur ?')) return;
      const formData = new FormData();
      formData.append('sale_id', currentSaleId);
      const res = await fetch('/client/history/mark-paid', { method: 'POST', body: formData });
      const data = await res.json();
      if (data && data.success) {
        alert('Paiement confirmé. Merci !');
        location.reload();
      } else {
        alert(data.error || 'Erreur lors de la confirmation');
      }
    });
  }

  // Export PDF (inchangé, mais avec animation de loading)
  document.getElementById('exportPDF').addEventListener('click', () => {
    // ... (votre code PDF inchangé, ajoutez une classe 'loading' au bouton si besoin pour spinner)
    try {
      // Code PDF existant...
    } catch (e) {
      alert('Erreur PDF: ' + e.message);
    }
  });
});
</script>
{% endblock %}

<style>
    :root {
        --primary: linear-gradient(135deg, #567AF4 0%, #3b5bdb 100%);
        --primary-dark: #3b5bdb;
        --success: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        --danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        --bg-primary: #231f20; /* Fond sombre du site */
        --bg-secondary: #2e2e2e;
        --text-primary: #fff;
        --text-secondary: #9ca3af;
        --border: #3a3a3a;
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
        --shadow-heavy: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.4);
        --radius: 12px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --animation-duration: 0.4s;
    }

    body.dark-theme {
        --bg-primary: #1e1e1e;
        --bg-secondary: #2a2a2a;
        --text-primary: #f7fafc;
        --text-secondary: #a0aec0;
        --border: #4a5568;
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
        --shadow-heavy: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    .historique-container {
        max-width: 1200px;
        margin: 80px auto 40px;
        padding: 24px;
        background: linear-gradient(135deg, var(--bg-primary) 0%, #1c1c1c 100%);
        border-radius: var(--radius);
        box-shadow: var(--shadow-heavy);
        opacity: 0;
        transform: scale(0.98);
        animation: pageLoad 0.6s ease-out forwards;
        transition: var(--transition);
    }

    .historique-container.loaded {
        opacity: 1;
        transform: scale(1);
    }

    @keyframes pageLoad {
        from { opacity: 0; transform: scale(0.98); }
        to { opacity: 1; transform: scale(1); }
    }

    .historique-container:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(86, 122, 244, 0.2);
    }

    /* Filter Card */
    .historique-filter-card {
        background: var(--bg-secondary);
        padding: 24px;
        border-radius: var(--radius);
        margin-bottom: 24px;
        box-shadow: var(--shadow-medium);
        transition: var(--transition);
        border: 1px solid var(--border);
    }

    .historique-filter-card:hover {
        box-shadow: var(--shadow-heavy);
        transform: translateY(-2px);
    }

    .historique-filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        align-items: end;
    }

    .historique-filter-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .historique-filter-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 600;
        color: var(--primary-dark);
        transition: var(--transition);
    }

    .historique-filter-label:hover {
        color: var(--primary);
    }

    .historique-filter-label i {
        font-size: 18px;
        color: var(--primary-dark);
        transition: transform 0.3s ease;
    }

    .historique-filter-label:hover i {
        transform: scale(1.1);
    }

    .historique-input {
        background: var(--bg-primary);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        padding: 12px 16px;
        font-size: 15px;
        color: var(--text-primary);
        transition: var(--transition);
        outline: none;
        box-shadow: var(--shadow-light);
    }

    .historique-input:focus {
        border-color: var(--primary-dark);
        box-shadow: 0 0 0 3px rgba(86, 122, 244, 0.1), var(--shadow-medium);
        transform: translateY(-2px);
    }

    .historique-filter-actions {
        display: flex;
        justify-content: flex-end;
    }

    .historique-button {
        background: var(--primary);
        color: var(--text-primary);
        border: none;
        border-radius: var(--radius);
        padding: 12px 20px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--shadow-medium);
        transition: var(--transition);
        animation: pulse 2s infinite;
    }

    .historique-button:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: var(--shadow-heavy);
        animation: none;
    }

    .historique-button i {
        font-size: 18px;
        transition: transform 0.3s ease;
    }

    .historique-button:hover i {
        transform: rotate(20deg);
    }

    /* Table Section */
    .historique-table-section {
        background: var(--bg-secondary);
        padding: 24px;
        border-radius: var(--radius);
        box-shadow: var(--shadow-medium);
        border: 1px solid var(--border);
        transition: var(--transition);
    }

    .historique-table-section:hover {
        box-shadow: var(--shadow-heavy);
        transform: translateY(-2px);
    }

    .historique-table-header {
        margin-bottom: 20px;
    }

    .historique-table-title {
        font-size: 22px;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition);
    }

    .historique-table-title:hover {
        color: var(--primary);
    }

    .historique-table-title i {
        color: var(--primary-dark);
        font-size: 22px;
        transition: transform 0.3s ease;
    }

    .historique-table-title:hover i {
        transform: scale(1.15);
    }

    .historique-table-container {
        overflow-x: auto;
        border-radius: 8px;
        box-shadow: var(--shadow-light);
    }

    .historique-table {
        width: 100%;
        border-collapse: collapse;
        color: var(--text-primary);
        font-size: 15px;
    }

    .historique-table th,
    .historique-table td {
        padding: 14px 18px;
        text-align: left;
        border-bottom: 1px solid var(--border);
        transition: var(--transition);
    }

    .historique-table th {
        background: var(--bg-primary);
        font-weight: 600;
        color: var(--primary-dark);
    }

    .historique-table tr.clickable-row {
        cursor: pointer;
        transition: var(--transition);
        animation: slideIn 0.4s ease-out;
    }

    .historique-table tr.clickable-row:hover {
        background: rgba(86, 122, 244, 0.1);
        transform: translateX(4px);
    }

    @keyframes slideIn {
        from { opacity: 0; transform: translateX(-10px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .historique-amount {
        font-weight: 600;
        color: var(--success);
    }

    .historique-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        transition: var(--transition);
        animation: badgeBounce 0.6s ease-out;
    }

    .historique-badge:hover {
        transform: scale(1.05);
    }

    .historique-badge-success {
        background: var(--success);
        color: var(--text-primary);
    }

    .historique-badge-danger {
        background: var(--danger);
        color: var(--text-primary);
    }

    @keyframes badgeBounce {
        0% { transform: scale(0.8); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }

    .historique-empty {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-secondary);
        font-style: italic;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .historique-empty i {
        font-size: 4rem;
        opacity: 0.5;
        animation: iconBounce 2s infinite;
    }

    @keyframes iconBounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }

    /* Modal */
    .custom-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 3000;
        display: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .custom-modal.active {
        opacity: 1;
    }

    .modal-overlay {
        background: rgba(0, 0, 0, 0.75);
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
    }

    .modal-container {
        background: var(--bg-secondary);
        border-radius: var(--radius);
        width: 90%;
        max-width: 650px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: var(--shadow-heavy);
        transform: scale(0.95);
        opacity: 0;
        transition: var(--transition);
        border: 1px solid var(--border);
    }

    .custom-modal.active .modal-container {
        transform: scale(1);
        opacity: 1;
        animation: fadeIn 0.3s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--bg-primary);
    }

    .modal-header h5 {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        transition: var(--transition);
    }

    .modal-header h5:hover {
        color: var(--primary);
    }

    .close-btn {
        background: transparent;
        border: none;
        font-size: 26px;
        color: var(--primary-dark);
        cursor: pointer;
        transition: var(--transition);
    }

    .close-btn:hover {
        color: var(--text-primary);
        transform: rotate(90deg);
    }

    .export-btn {
        background: var(--primary);
        color: var(--text-primary);
        border: none;
        border-radius: var(--radius);
        padding: 12px 20px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: var(--shadow-medium);
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .export-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-heavy);
    }

    .modal-body {
        padding: 24px;
        color: var(--text-primary);
        font-size: 15px;
    }

    .modal-body .invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-light);
    }

    .modal-body .invoice-table th,
    .modal-body .invoice-table td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        transition: var(--transition);
    }

    .modal-body .invoice-table th {
        background: var(--bg-primary);
        color: var(--primary-dark);
        font-weight: 600;
    }

    .modal-body .invoice-table tr:hover {
        background: rgba(86, 122, 244, 0.05);
    }

    .modal-body .client,
    .modal-body .seller,
    .modal-body .invoice-status {
        margin-bottom: 16px;
        padding: 16px;
        background: var(--bg-primary);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        transition: var(--transition);
    }

    .modal-body .client:hover,
    .modal-body .seller:hover,
    .modal-body .invoice-status:hover {
        background: rgba(86, 122, 244, 0.05);
        transform: translateY(-1px);
    }

    .custom-modal:not(.active) .modal-container {
        animation: slideOut 0.3s ease forwards;
    }

    @keyframes slideOut {
        from { transform: scale(1); opacity: 1; }
        to { transform: scale(0.95); opacity: 0; }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .historique-container {
            padding: 16px;
            margin: 70px 16px 16px;
            border-radius: var(--radius);
        }

        .historique-filter-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .historique-table th,
        .historique-table td {
            padding: 10px 12px;
            font-size: 13px;
        }

        .historique-table-container {
            /* Stack columns on very small screens if needed */
        }

        .modal-container {
            width: 95%;
            max-height: 90vh;
            padding: 0;
        }

        .modal-header,
        .modal-body {
            padding: 16px 20px;
        }

        .export-btn {
            padding: 10px 16px;
            font-size: 14px;
        }
    }

    @media (max-width: 480px) {
        .historique-filter-card,
        .historique-table-section {
            padding: 16px;
        }

        .historique-table {
            font-size: 12px;
        }

        /* Stack table rows vertically if needed (optional advanced) */
        .historique-table th,
        .historique-table td {
            display: block;
            width: 100%;
            padding: 8px;
        }

        .historique-table thead {
            display: none;
        }

        .historique-table tr {
            margin-bottom: 16px;
            display: block;
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .historique-table td {
            border: none;
            position: relative;
            padding-left: 50%;
        }

        .historique-table td:before {
            content: attr(data-label) ": ";
            position: absolute;
            left: 8px;
            font-weight: 600;
            color: var(--primary-dark);
        }
    }

    /* Custom Scrollbar (comme dans messages) */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg-primary);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--text-secondary);
        border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--primary-dark);
    }

    /* Loading Spinner (pour PDF ou fetch) */
    .loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,.3);
        border-radius: 50%;
        border-top-color: var(--text-primary);
        animation: spin 1s ease-in-out infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>