<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Live</title>
    <link href="https://fonts.googleapis.com/css?family=Inter:400,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #7c3aed;
            --primary-dark: #6d28d9;
            --primary-light: #ede9fe;
            --success: #10b981;
            --danger: #ef4444;
            --dark: #1f2937;
            --gray: #6b7280;
            --gray-light: #e5e7eb;
            --light: #f8fafc;
            --radius: 16px;
            --radius-sm: 12px;
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.1), 0 4px 6px rgba(0,0,0,0.05);
            --shadow-xl: 0 20px 25px rgba(0,0,0,0.1), 0 10px 10px rgba(0,0,0,0.04);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        body { margin:0; font-family: 'Inter', Arial, sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); color: var(--dark); }
        .page { padding: 100px 20px 30px; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 340px; gap: 24px; }
        .player-card { background:#fff; border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden; }
        .player-thumb { position: relative; width: 100%; padding-top: 56.25%; border-radius: var(--radius); overflow:hidden; background:#000; }
        .player-thumb img, .player-thumb video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
        .live-badge { position:absolute; top:12px; left:50%; transform: translateX(-50%); background:#ff3b30; color:#fff; font-weight:700; padding:6px 14px; border-radius:999px; }
        .viewer-group { position:absolute; top:12px; left:12px; display:flex; align-items:center; gap:8px; }
        .viewer-icons { display:flex; align-items:center; gap:6px; background:#ffffff; color:var(--primary); border-radius:999px; padding:4px 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.12); }
        .viewer-pill { background: var(--primary); color:#fff; padding:4px 10px; border-radius:999px; font-weight:700; box-shadow: var(--shadow-lg); }
        .below-bar { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:14px 18px 16px; }
        .meta { display:flex; align-items:center; gap:12px; }
        .avatar { width:40px; height:40px; border-radius:50%; overflow:hidden; }
        .avatar img { width:100%; height:100%; object-fit:cover; }
        .username-chip { background:#1e90ff; color:#fff; padding:6px 12px; border-radius:999px; font-weight:700; }
        .follow-wrap { margin-top:10px; }
        .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:12px 18px; border-radius:12px; border:none; cursor:pointer; font-weight:700; box-shadow: var(--shadow-lg); transition: var(--transition); }
        .btn-like { background: var(--primary); color:#fff; }
        .btn-like:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: var(--shadow-xl); }
        .btn-cart { background: var(--primary); color:#fff; }
        .btn-cart:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: var(--shadow-xl); }
        .btn-follow { background: var(--success); color:#fff; }
        .btn-follow:hover { filter: brightness(0.95); transform: translateY(-2px); }
        .right-actions { display:flex; gap:14px; }
        .description { background:#fff; border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 16px 18px; margin-top: 8px; }
        .desc-title { font-weight:1000; margin-bottom:8px; }
        .desc-list { list-style:none; padding:0; margin:0 0 8px; }
        .desc-list li { display:flex; align-items:flex-start; gap:8px; margin:6px 0; }
        .desc-list li .dot { width:8px; height:8px; background:#567AF4; border-radius:50%; margin-top:6px; }
        .products { display:flex; flex-direction:column; gap:16px; }
        
        /* Styles pour les produits - MODIFIÉ selon l'image */
        .product { 
            display: flex; 
            gap: 12px; 
            background: #fff; 
            border-radius: var(--radius); 
            padding: 12px; 
            box-shadow: var(--shadow-lg); 
            align-items: center;
            position: relative;
            transition: var(--transition);
        }
        .product:hover { transform: translateY(-3px); box-shadow: var(--shadow-xl); }
        .product img { 
            width: 92px; 
            height: 64px; 
            object-fit: cover; 
            border-radius: 12px; 
        }
        .product-info {
            flex-grow: 1;
        }
        .product .name { 
            font-weight: 800; 
            margin-bottom: 4px;
        }
        .product .price { 
            color: #333; 
            margin-top: 4px; 
            font-weight: 600;
        }
        /* Promo badge and price visuals */
        .promo-badge {
          background: linear-gradient(135deg, #ff4757, #ff3742);
          color: #fff;
          font-weight: 900;
          padding: 6px 12px;
          border-radius: 20px;
          font-size: 11px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          margin-left: 8px;
          vertical-align: middle;
          box-shadow: 0 2px 8px rgba(255, 71, 87, 0.3);
          text-transform: uppercase;
          letter-spacing: 0.5px;
          border: 2px solid #fff;
        }
        .product-promo-badge {
          position: absolute;
          top: 8px;
          left: 8px;
          background: linear-gradient(135deg, #ff4757, #ff3742);
          color: #fff;
          font-weight: 900;
          padding: 4px 8px;
          border-radius: 12px;
          font-size: 10px;
          box-shadow: 0 2px 6px rgba(255, 71, 87, 0.4);
          text-transform: uppercase;
          letter-spacing: 0.3px;
          border: 1px solid #fff;
          z-index: 2;
        }
        .price-container { 
          display: flex; 
          align-items: center; 
          gap: 8px; 
          flex-wrap: wrap;
        }
        .price-current { 
          color: #e74c3c; 
          font-weight: 900; 
          font-size: 1.1rem; 
          text-shadow: 0 1px 2px rgba(231, 76, 60, 0.2);
        }
        .price-base s { 
          color: #95a5a6; 
          font-weight: 600; 
          font-size: 0.9rem; 
          text-decoration-thickness: 2px;
          text-decoration-color: #e74c3c;
        }
        .price-regular { 
          font-weight: 700; 
          font-size: 1rem; 
          color: var(--dark); 
        }
        .product-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }
        .btn-bag { 
            background: var(--primary); 
            color: #fff; 
            border: none; 
            padding: 8px 12px; 
            border-radius: 999px; 
            cursor: pointer; 
            font-weight: 700; 
            white-space: nowrap;
            margin-top: 50px;
            transition: var(--transition);
        }
        .btn-bag:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
        .btn-favorite {
            position: absolute;
            top: 16px;
            right: 25px;
            width: 20px;
            height: 28px;
            border-radius: 2px;
            background-color: #ccc;
            border: none;
            cursor: pointer;
            clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
            transition: background-color 0.3s, transform 0.2s;
            z-index: 1;
        }
        .btn-favorite:hover {
            transform: scale(1.1);
        }
        .btn-favorite.active {
            background-color: #e3f635ff;
            transform: scale(1.2);
        }
        
        @media (max-width: 992px) { 
            .page { grid-template-columns: 1fr; } 
            .right-actions{ margin-top:10px; } 
        }
        
        /* Dark theme */
        body.dark-theme { background: #121212; }
        body.dark-theme .player-card, 
        body.dark-theme .description, 
        body.dark-theme .product { 
            background:#1f1f1f; 
            box-shadow: 0 12px 24px rgba(0,0,0,0.5); 
        }
        body.dark-theme .desc-title, 
        body.dark-theme .product .name, 
        body.dark-theme .product .price { 
            color:#fff; 
        }
        /* Lisibilité du contenu de la description en dark */
        body.dark-theme .description { color: #e6e6e6; }
        body.dark-theme .description p { color: #e0e0e0; line-height: 1.55; }
        body.dark-theme .description li { color: #e0e0e0; }
        body.dark-theme .description a { color: #9ec1ff; }
        /* Dark theme pour les prix */
        body.dark-theme .price-regular { color: #e0e0e0; }
        body.dark-theme .price-current { color: #ff6b7a; }
        body.dark-theme .price-base s { color: #9ca3af; }
  /* Floating hearts animation */
  /* Layer that holds the hearts inside the player-thumb (so they appear on the video area) */
  .player-thumb .hearts-layer { position: absolute; inset: 0; pointer-events: none; z-index: 6; overflow: hidden; }
  .hearts-container { position:absolute; inset:0; pointer-events:none; overflow:hidden; contain: layout paint; }
  .heart { position:absolute; bottom:10px; font-size:24px; will-change: transform, opacity; animation: floatUp 2.8s cubic-bezier(.22,.61,.36,1) forwards; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25)); transform: translate3d(0,0,0); backface-visibility: hidden; }
  /* Admin-style floating heart (matching admin/live.html.twig) */
  .player-thumb .floating-heart {
    transform: translateY(0);
    will-change: transform, opacity;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
  }

  @keyframes float-heart {
    0% { transform: translateY(0) translateX(0); opacity: 1; }
    100% { transform: translateY(-220px) translateX(40px); opacity: 0; }
  }
        @keyframes floatUp {
          0% { transform: translate3d(var(--drift, 0%), 0, 0) scale(0.9); opacity: 0; }
          20% { transform: translate3d(var(--drift, 0%), -60%, 0) scale(1.0); opacity: 0.9; }
          80% { transform: translate3d(var(--drift, 0%), -220%, 0) scale(1.25); opacity: 0.9; }
          100% { transform: translate3d(var(--drift, 0%), -320%, 0) scale(1.35); opacity: 0; }
        }
    /* Product variant selectors (sizes & colors) */
    .product-variants { margin-top: 8px; display:flex; gap:12px; align-items:center; }
    .variant-group { display:flex; flex-direction:column; gap:6px; }
    .variant-label { font-size:12px; color:var(--gray); font-weight:700; }
    .size-select { padding:6px 8px; border-radius:8px; border:1px solid #e5e7eb; }
    .colors-list { display:flex; gap:8px; align-items:center; }
    .color-item { width:28px; height:28px; border-radius:50%; overflow:hidden; cursor:pointer; border:2px solid transparent; display:flex; align-items:center; justify-content:center; }
    .color-item.active { border-color: var(--primary); }
    .color-item img { width:100%; height:100%; object-fit:cover; display:block; }
    .color-swatch { width:18px; height:18px; border-radius:50%; display:block; }
    </style>
    {% include 'components/navbarClient.html.twig' %}
    <script>
      function likeLive(){
        const el = document.getElementById('likeCount');
        if (el) {
          el.textContent = (parseInt(el.textContent || '0', 10) + 1).toString();
        }

        // animation de coeurs (admin-style) : créer plusieurs cœurs avec léger décalage
        for (let i = 0; i < 6; i++) {
          setTimeout(() => createFloatingHeart(), i * 80);
        }

        // 🔥 Envoi du like au serveur WebSocket
        if (window.signaling && window.signaling.readyState === WebSocket.OPEN) {
          const adminId = {{ live.seller ? live.seller.id : 0 }};
          window.signaling.send(JSON.stringify({
            type: "like",
            adminId: adminId
          }));
        }
      }

      function spawnHearts(container, count = 6){
        if (!container) return;
        // Ensure there is a dedicated hearts layer inside the player-thumb
        let heartsLayer = container.querySelector('.hearts-layer');
        if (!heartsLayer) {
          heartsLayer = document.createElement('div');
          heartsLayer.className = 'hearts-layer';
          container.appendChild(heartsLayer);
        }
        // Inside the layer we keep a single hearts-container for positioning
        let heartsContainer = heartsLayer.querySelector('.hearts-container');
        if (!heartsContainer) {
          heartsContainer = document.createElement('div');
          heartsContainer.className = 'hearts-container';
          heartsLayer.appendChild(heartsContainer);
        }

        for (let i = 0; i < count; i++) {
          const heart = document.createElement('div');
          heart.className = 'heart';
          heart.textContent = '❤️';

          const left = Math.random() * 80 + 10; // 10% - 90%
          const size = Math.random() * 12 + 18; // 18px - 30px
          const drift = (Math.random() * 40 - 20); // -20% à 20%
          const duration = (Math.random() * 1.0 + 2.2).toFixed(2); // 2.2s - 3.2s
          const delay = (Math.random() * 0.2).toFixed(2); // 0 - 0.2s

          heart.style.left = left + '%';
          heart.style.fontSize = size + 'px';
          heart.style.animationDuration = duration + 's';
          heart.style.animationDelay = delay + 's';
          heart.style.setProperty('--drift', drift + '%');

          heartsContainer.appendChild(heart);

          const removeAfter = (parseFloat(duration) + parseFloat(delay)) * 1000 + 200;
          setTimeout(() => { heart.remove(); }, removeAfter);
        }
      }

      // createFloatingHeart: admin-like implementation that appends a floating heart into the player-thumb hearts-layer
      function createFloatingHeart() {
        const heart = document.createElement('div');
        const heartEmojis = '❤️';

        heart.className = 'floating-heart';
        heart.innerHTML = heartEmojis;

        // target the hearts-layer inside player-thumb
        const heartsLayer = document.querySelector('.player-thumb .hearts-layer');
        const container = heartsLayer || document.body;

        const rect = container.getBoundingClientRect();
        const startX = Math.random() * rect.width;
        const duration = Math.random() * 1 + 3; // 3 - 4s
        const size = Math.random() * 20 + 30; // 30 - 50px

        heart.style.cssText = `
          position: absolute;
          font-size: ${size}px;
          left: ${startX}px;
          bottom: -50px;
          pointer-events: none;
          z-index: 5;
          opacity: 1;
          animation: float-heart ${duration}s ease-out forwards;
        `;

        container.appendChild(heart);

        setTimeout(() => {
          if (heart.parentNode) heart.remove();
        }, duration * 1000 + 200);
      }

    function toggleFavorite(button, itemSizeId) {
      if (button.classList.contains('active') && button.dataset.favoriteId && button.dataset.favoriteId !== 'null') {
        // Retirer des favoris par favoriteId
        fetch(`/client/remove-favorite-by-id/${button.dataset.favoriteId}`, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({})
        })
        .then(res => {
          if (!res.ok) throw new Error('Erreur serveur: ' + res.status);
          return res.json ? res.json() : null;
        })
        .then(data => {
          button.classList.remove('active');
        })
        .catch(err => console.error('Fetch error:', err));
      } else {
        // Ajouter aux favoris par itemSizeId
        fetch(`/client/favorite/toggle/${button.dataset.itemSizeId}`, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({})
        })
        .then(res => {
          if (!res.ok) throw new Error('Erreur serveur: ' + res.status);
          return res.json();
        })
        .then(data => {
          if (data.success && data.action === 'added') {
            button.classList.add('active');
          } else if (data.action === 'exists') {
            button.classList.add('active');
          }
        })
        .catch(err => console.error('Fetch error:', err));
      }
    }


      // WebRTC Viewer pour recevoir le flux du streamer via un serveur de signalisation WebSocket (localhost:8080)
      document.addEventListener('DOMContentLoaded', function(){
        const videoEl = document.getElementById('livePlayer');
        if (!videoEl) return;

        let pc = null;
        let signaling = null;
        // Détection auto de l'URL du serveur de signalisation avec fallback localhost
        const params = new URLSearchParams(window.location.search);
        const forcedSignalHost = params.get('signal');
        const proto = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const altProto = proto === 'wss' ? 'ws' : 'wss';
        const host = window.location.hostname || 'localhost';
        const port = 9090;
        const baseHosts = [host, 'localhost', '127.0.0.1', '192.168.88.28'];
        const hosts = Array.from(new Set([
          ...(forcedSignalHost ? [forcedSignalHost] : []),
          ...baseHosts
        ]));
        const urlsTmp = [];
        hosts.forEach(h => { urlsTmp.push(`${proto}://${h}:${port}`); urlsTmp.push(`${altProto}://${h}:${port}`); });
        const urls = Array.from(new Set(urlsTmp));
        console.log('[CLIENT-LIVE] WS candidates =', urls);
        function connectWS(url, onFail) {
          try {
            const ws = new WebSocket(url);
            ws.onerror = () => {
              if (onFail) onFail();
            };
            return ws;
          } catch (e) {
            if (onFail) onFail();
            return null;
          }
        }
        let idx = 0;
        function tryNext(){
          if (idx >= urls.length) {
            console.error('[CLIENT-LIVE] WS: toutes les tentatives ont échoué');
            return;
          }
          const url = urls[idx++];
          console.log('[CLIENT-LIVE] WS connecting', url);
          signaling = connectWS(url, tryNext);
        }
        tryNext();
        if (!signaling) return;

        // Suivre/Ne plus suivre le vendeur du live
        const followBtn = document.getElementById('followBtn');
        if (followBtn) {
          const sellerId = {{ live.seller ? live.seller.id : 0 }};
          const textEl = followBtn.querySelector('.follow-text');
          const iconEl = followBtn.querySelector('i');
          followBtn.addEventListener('click', function() {
            fetch(`/client/follow/toggle/${sellerId}`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }})
              .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
              .then(data => {
                if (!data.success) return;
                if (data.action === 'followed') {
                  textEl.textContent = 'Following';
                  iconEl.classList.remove('fa-user-plus');
                  iconEl.classList.add('fa-user-check');
                } else if (data.action === 'unfollowed') {
                  textEl.textContent = 'Follow';
                  iconEl.classList.remove('fa-user-check');
                  iconEl.classList.add('fa-user-plus');
                }
              })
              .catch(err => console.error('Follow error:', err));
          });
        }

        function createPeerConnection(){
          pc = new RTCPeerConnection({
            iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
          });
          pc.ontrack = (event) => {
            if (event.streams && event.streams[0]) {
              videoEl.srcObject = event.streams[0];
              console.log('[CLIENT-LIVE] ontrack stream reçu');
            }
          };
          pc.onicecandidate = (e) => {
            if (e.candidate) {
              console.log('[CLIENT-LIVE] ICE -> streamer');
              signaling.send(JSON.stringify({ type: 'candidate', candidate: e.candidate, target: 'streamer', viewerId: signaling.viewerId }));
            }
          };
          pc.onconnectionstatechange = () => console.log('[CLIENT-LIVE] pc.connectionState', pc.connectionState);
          pc.onsignalingstatechange = () => console.log('[CLIENT-LIVE] pc.signalingState', pc.signalingState);
          pc.onicegatheringstatechange = () => console.log('[CLIENT-LIVE] pc.iceGatheringState', pc.iceGatheringState);
        }

        signaling.onopen = () => {
          const viewerId = Math.random().toString(36).slice(2);
          signaling.viewerId = viewerId;
          const adminId = {{ live.seller ? live.seller.id : 0 }};
          console.log('[CLIENT-LIVE] WS open. viewerId=', viewerId, 'adminId=', adminId);
          signaling.send(JSON.stringify({ type: 'viewer', viewerId, adminId }));
          window.signaling = signaling; // rendre accessible globalement
        };

        let totalLikes = 0;

        signaling.onmessage = async (event) => {
          const data = JSON.parse(event.data);
          console.log('[CLIENT-LIVE] WS message', data);
          try {
            if (data.type === 'offer') {
              console.log('[CLIENT-LIVE] offer reçue');
              if (!pc) createPeerConnection();
              await pc.setRemoteDescription(new RTCSessionDescription(data.offer));
              const answer = await pc.createAnswer();
              await pc.setLocalDescription(answer);
              signaling.send(JSON.stringify({ type: 'answer', answer, viewerId: signaling.viewerId }));
              console.log('[CLIENT-LIVE] answer envoyée, viewerId=', signaling.viewerId);
            } else if (data.type === 'candidate' && pc) {
              console.log('[CLIENT-LIVE] ICE <- streamer');
              await pc.addIceCandidate(new RTCIceCandidate(data.candidate));
            } else if (data.type === 'end') {
              console.warn('[CLIENT-LIVE] Fin du live reçue');
              videoEl.pause();
              videoEl.poster = '{{ live.seller and live.seller.images ? '/uploads/' ~ live.seller.images : '/uploads/6891e6164b5d5.jpg' }}';
              if (videoEl.srcObject) {
                videoEl.srcObject.getTracks().forEach(t => t.stop());
                videoEl.srcObject = null;
              }
            }
            else if (data.type === 'likeUpdate') {
              const prev = totalLikes || 0;
              totalLikes = data.count || 0;
              const likeEl = document.getElementById('likeCount');
              if (likeEl) likeEl.textContent = totalLikes;

              const pillEl = document.querySelector('.viewer-pill');
              if (pillEl) pillEl.textContent = totalLikes;

              const newLikes = Math.max(0, totalLikes - prev);
              if (newLikes > 0) {
                // create admin-like floating hearts, staggered
                const spawnCount = Math.min(12, newLikes);
                for (let i = 0; i < spawnCount; i++) {
                  setTimeout(() => createFloatingHeart(), i * 100);
                }
              }
            }


          } catch (err) {
            console.error('[CLIENT-LIVE] Erreur WebRTC:', err);
          }
        };

        window.addEventListener('beforeunload', () => {
          console.log('[CLIENT-LIVE] Unload: fermeture connexions');
          try { if (pc) pc.close(); } catch(e){}
          try { if (signaling) signaling.close(); } catch(e){}
        });
      });
    </script>
  </head>
  <body>
    <div class="page">
        <div>
            <div class="player-card">
        <div class="player-thumb">
          <video id="livePlayer" autoplay muted playsinline controls poster="{{ live.seller and live.seller.images ? '/uploads/' ~ live.seller.images : '/uploads/6891e6164b5d5.jpg' }}"></video>
          <div class="hearts-layer"></div>
          {% if live.endLive is null %}<div class="live-badge">Live</div>{% endif %}
          <div class="viewer-group">
                        <div class="viewer-icons">
                            <i class="fas fa-comments"></i>
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="viewer-pill">{{ live.nbrLike|default(0) }}</div>
                    </div>
                </div>

                <div class="below-bar">
                    <div>
                        <div class="meta">
                            <div class="avatar"><img src="{{ live.seller and live.seller.images ? '/uploads/' ~ live.seller.images : '/uploads/6891f6e39d5a3.jpg' }}" alt="avatar"></div>
                            <div class="username-chip">{{ live.seller ? live.seller.username : 'Username' }}</div>
                        </div>
                        <div class="follow-wrap">
                            <button class="btn btn-follow" id="followBtn">
                                <i class="fa-solid {{ isFollowing ? 'fa-user-check' : 'fa-user-plus' }}"></i>
                                <span class="follow-text">{{ isFollowing ? 'Following' : 'Follow' }}</span>
                            </button>
                        </div>
                    </div>
                    <div class="right-actions">
                        <button class="btn btn-like" onclick="likeLive()">
                            <i class="fas fa-heart"></i>
                            Like 
                            {# <span id="likeCount">{{ live.nbrLike|default(0) }}</span> #}
                        </button>
                        <form action="{{ path('app_client_panier') }}" method="get">
                        <button type="submit" class="btn btn-cart">
                            <i class="fa-solid fa-bag-shopping"></i>
                            Cart
                        </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="description">
                <div class="desc-title">Description</div>
                <p style="white-space: pre-line; line-height: 1.6;">
                    {{ live.description ?: 'Live de ' ~ (live.seller ? live.seller.username : 'notre streamer') }}
                </p>
            </div>
        </div>

        <aside>
            <div class="products">
                {% if items is defined and items|length > 0 %}
                    {% for product in items %}
                        <div class="product" data-product-id="{{ product.getItem.getId }}">
                {# Price display: show promo price if an active promotion exists, and show base price struck-through #}
                {% set priceItems = product.getItem.getPriceItems %}
                {% set lastPrice = priceItems|length > 0 ? priceItems|last.getPrice : 0 %}
                {% set previousPrice = priceItems|length > 1 ? priceItems[priceItems|length - 2].getPrice : null %}
                
                {# Check for active promotions #}
                {% set activePromo = null %}
                {% set now = "now"|date %}
                {% for promo in product.getItem.getPromotions %}
                  {# consider promotion active if within start/end dates (or no end date) #}
                  {% if activePromo is null and promo.getStartDate is not null and promo.getStartDate <= now and (promo.getEndDate is null or promo.getEndDate >= now) %}
                    {% set activePromo = promo %}
                  {% endif %}
                {% endfor %}
                
                {# Calculate percentage reduction if price dropped or if there's an active promotion #}
                {% set percentage = null %}
                {% set isPriceReduced = false %}
                
                {% if activePromo %}
                  {% set percentage = activePromo.getPercentage + 0 %}
                {% elseif previousPrice and previousPrice > lastPrice %}
                  {# Calculate percentage reduction when price dropped #}
                  {% set percentage = ((previousPrice - lastPrice) / previousPrice * 100)|round %}
                  {% set isPriceReduced = true %}
                {% endif %}
                <button class="btn-favorite {% if product.getItem.getId in favorisIds %}active{% endif %}"
                    aria-label="Basculer favori"
                    data-item-id="{{ product.getItem.getId }}"
                    onclick="toggleFavoriteProduct(this)"></button>
                {% if activePromo or isPriceReduced %}
                  {# <div class="product-promo-badge">-{{ percentage|round(0, 'common') }}%</div> #}
                {% endif %}
                <img src="{{ product.getItem.getImages ? '/uploads/' ~ product.getItem.getImages : '/uploads/default-product.jpg' }}" alt="{{ product.getItem.getNameItem }}">
                <div class="product-info">
                  <div class="name">{{ product.getItem.getNameItem }}</div>

                  <div class="price-container">
                    {% if activePromo %}
                      {% set percentage = activePromo.getPercentage + 0 %}
                      {% set promoPrice = (lastPrice * (100 - percentage) / 100) %}
                      <span class="price-current">{{ promoPrice|number_format(2, '.', ',') }} $</span>
                      <span class="price-base"><s>{{ lastPrice|number_format(2, '.', ',') }} $</s></span>
                      <span class="promo-badge">-{{ percentage|round(0, 'common') }}%</span>
                    {% elseif isPriceReduced %}
                      <span class="price-current">{{ lastPrice|number_format(2, '.', ',') }} $</span>
                      <span class="price-base"><s>{{ previousPrice|number_format(2, '.', ',') }} $</s></span>
                      <span class="promo-badge">-{{ percentage|round(0, 'common') }}%</span>
                    {% else %}
                      <span class="price-regular">{{ lastPrice|number_format(2, '.', ',') }} $</span>
                    {% endif %}
                  </div>

                  {# helper text removed per user request #}
                </div>
                {# embed sizes/colors JSON for modal usage (hidden) #}
                {% set sizes_map = [] %}
                {% for size in product.getItem.getItemSizes %}
                  {% set sizes_map = sizes_map|merge([{'id': size.getId, 'value': size.getValueSize}]) %}
                {% endfor %}
                <script type="application/json" class="sizes-json" data-product-id="{{ product.getItem.getId }}">{{ sizes_map|json_encode|raw }}</script>
                {% set colors_map = {} %}
                {% for size in product.getItem.getItemSizes %}
                  {% set size_colors = [] %}
                  {% for isc in size.getItemSizeColors %}
                    {% set color = isc.getColor %}
                    {% if color %}
                      {% set img = null %}
                      {% if isc.getImages is defined and isc.getImages %}
                        {% set img = '/uploads/' ~ isc.getImages %}
                      {% endif %}
                      {% set color_data = {'id': color.getId, 'name': color.getNameColor, 'image': img} %}
                      {# Vérifier si cette couleur n'existe pas déjà pour éviter les doublons #}
                      {% set exists = false %}
                      {% for existing_color in size_colors %}
                        {% if existing_color.id == color.getId %}
                          {% set exists = true %}
                        {% endif %}
                      {% endfor %}
                      {% if not exists %}
                        {% set size_colors = size_colors|merge([color_data]) %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                  {% set colors_map = colors_map|merge({ (size.getId) : size_colors }) %}
                {% endfor %}
                
                {# Debug: afficher les couleurs disponibles pour ce produit #}
                <script>console.log('Colors for product {{ product.getItem.getId }}:', {{ colors_map|json_encode|raw }});</script>
                <script type="application/json" class="colors-json" data-product-id="{{ product.getItem.getId }}">{{ colors_map|json_encode|raw }}</script>
            <div class="product-actions">
            <button class="btn-bag" onclick="openProductModal({{ product.getItem.getId }}, '{{ product.getItem.getNameItem|e('js') }}', '{{ lastPrice }}', '{{ product.getItem.getImages|default('')|e('js') }}', {{ (activePromo or isPriceReduced) ? percentage : 'null' }}, {{ isPriceReduced and previousPrice ? previousPrice : 'null' }})">Voir</button>
          </div>
  <script>
  function addToBag(btn, id, name, price, images) {
    btn.disabled = true;
    btn.textContent = 'Ajout...';
    fetch(`/client/add-cart/${id}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: `name=${encodeURIComponent(name)}&price=${encodeURIComponent(price)}&images=${encodeURIComponent(images)}&quantity=1`
    })
    .then(res => {
      if (!res.ok) throw new Error('Erreur serveur');
      btn.textContent = 'Ajouté !';
      btn.classList.add('added');
      btn.style.background = '#28a745';
    })
    .catch(() => {
      btn.textContent = 'Erreur';
      btn.style.background = '#dc3545';
    });
  }
  </script>
  <script>
  function toggleFavoriteProduct(button){
    const itemId = button.dataset.itemId;
    const isActive = button.classList.contains('active');
    const url = isActive ? `/client/favorite/remove-all-sizes/${itemId}` : `/client/favorite/toggle-all-sizes/${itemId}`;
    fetch(url, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => {
      if(!res.ok) throw new Error('Erreur serveur: ' + res.status);
      return res.json();
    })
    .then(data => {
      if (!data.success) return;
      button.classList.toggle('active');
    })
    .catch(err => console.error('Favori erreur:', err));
  }
  </script>
                        </div>
                    {% endfor %}

                {% else %}
                    <p>Aucun produit associé à ce live.</p>
                {% endif %}
            </div>
        </aside>
    </div>
  <script>
    // Initialize color lists and wire size/color interactions for products in the live sidebar
    (function(){
      function renderColorsForProduct(productId) {
        const jsonEl = document.querySelector(`.colors-json[data-product-id="${productId}"]`);
        const container = document.querySelector(`.colors-list[data-product-id="${productId}"]`);
        const sizeSelect = document.querySelector(`.size-select[data-product-id="${productId}"]`);
        if (!jsonEl || !container) return;
        let colorsMap = {};
        try { colorsMap = JSON.parse(jsonEl.textContent || '{}'); } catch(e){ colorsMap = {}; }

        const selectedSize = sizeSelect ? sizeSelect.value : Object.keys(colorsMap)[0];
        container.innerHTML = '';
        const colors = colorsMap[selectedSize] || [];
        if (colors.length === 0) {
          container.innerHTML = `<div class="text-muted">Non disponible</div>`;
          return;
        }

        colors.forEach(c => {
          const btn = document.createElement('div');
          btn.className = 'color-item';
          btn.dataset.colorId = c.id;
          btn.dataset.productId = productId;
          if (c.image) {
            const img = document.createElement('img'); img.src = c.image; img.alt = c.name || 'color';
            btn.appendChild(img);
          } else {
            const sw = document.createElement('span'); sw.className = 'color-swatch'; sw.style.background = c.name || '#ccc';
            btn.appendChild(sw);
          }
          btn.addEventListener('click', () => {
            // mark active
            container.querySelectorAll('.color-item').forEach(x => x.classList.remove('active'));
            btn.classList.add('active');
            // swap product thumbnail image seulement si l'image de couleur existe
            const productCard = btn.closest('.product');
            if (productCard && c.image) {
              const imgEl = productCard.querySelector('img');
              if (imgEl) {
                imgEl.src = c.image;
                imgEl.alt = c.name || 'Produit';
              }
            }
            // store selection on the container for addToBag
            container.dataset.selectedColor = c.id;
          });
          container.appendChild(btn);
        });
      }

      // init for all products
      document.querySelectorAll('.colors-json').forEach(el => {
        renderColorsForProduct(el.dataset.productId);
      });

      // size change handling
      document.addEventListener('change', (e) => {
        if (e.target && e.target.classList && e.target.classList.contains('size-select')) {
          const productId = e.target.dataset.productId;
          renderColorsForProduct(productId);
        }
      });

      // override global addToBag to include selected variants
      const originalAdd = window.addToBag;
      window.addToBag = function(btn, id, name, price, images) {
        const productCard = btn.closest('.product');
        let itemSizeId = null;
        let colorId = null;
        if (productCard) {
          const sizeSel = productCard.querySelector('.size-select');
          if (sizeSel) itemSizeId = sizeSel.value || null;
          const colorsList = productCard.querySelector('.colors-list');
          if (colorsList) colorId = colorsList.dataset.selectedColor || null;
        }

        btn.disabled = true;
        btn.textContent = 'Ajout...';

        const params = new URLSearchParams();
        params.append('name', name);
        params.append('price', price);
        params.append('images', images);
        params.append('quantity', '1');
        if (itemSizeId) params.append('itemSizeId', itemSizeId);
        if (colorId) params.append('colorId', colorId);

        fetch(`/client/add-cart/${id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: params.toString()
        }).then(res => {
          if (!res.ok) throw new Error('Erreur serveur');
          btn.textContent = 'Ajouté !';
          btn.classList.add('added');
          btn.style.background = '#28a745';
        }).catch(() => {
          btn.textContent = 'Erreur';
          btn.style.background = '#dc3545';
        });
      };
    })();
    
    // Product modal (global)
    (function(){
      const modalHtml = `
        <div id="productModal" style="display:none; position:fixed; inset:0; z-index:10000; align-items:center; justify-content:center;">
          <div style="background:#fff; border-radius:12px; padding:18px; width:420px; max-width:95%; box-shadow:0 10px 30px rgba(0,0,0,0.2); position:relative;">
            <button id="closeModal" style="position:absolute; right:10px; top:10px; background:transparent; border:none; font-size:18px; cursor:pointer;">✕</button>
            <div style="display:flex; gap:12px;">
              <div style="position:relative;">
                <img id="modalImage" src="" alt="" style="width:120px; height:90px; object-fit:cover; border-radius:8px;">
                <div id="modalPromoBadge" style="position:absolute; top:4px; left:4px; background:linear-gradient(135deg, #ff4757, #ff3742); color:#fff; font-weight:900; padding:3px 6px; border-radius:8px; font-size:9px; box-shadow:0 2px 4px rgba(255,71,87,0.4); text-transform:uppercase; letter-spacing:0.3px; border:1px solid #fff; display:none;"></div>
              </div>
              <div style="flex:1;">
                <h3 id="modalTitle" style="margin-top:0;margin-bottom:8px;font-size:16px"></h3>
                <div id="modalPrice" style="font-weight:800;margin-bottom:8px"></div>
                <div style="margin-bottom:8px">
                  <label style="font-weight:700;display:block;margin-bottom:6px">Taille</label>
                  <select id="modalSize" style="width:100%;padding:8px;border-radius:8px;border:1px solid #e5e7eb"></select>
                </div>
                <div style="margin-bottom:12px">
                  <label style="font-weight:700;display:block;margin-bottom:6px">Couleur</label>
                  <div id="modalColors" style="display:flex;gap:8px;flex-wrap:wrap"></div>
                </div>
                <div style="display:flex;gap:8px;align-items:center">
                  <button id="modalAddBtn" class="btn btn-bag">Ajouter au panier</button>
                  <button id="modalCloseBtn" class="btn" style="background:#eee">Annuler</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
      document.body.insertAdjacentHTML('beforeend', modalHtml);

      const modal = document.getElementById('productModal');
      const modalImage = document.getElementById('modalImage');
      const modalTitle = document.getElementById('modalTitle');
      const modalPrice = document.getElementById('modalPrice');
      const modalSize = document.getElementById('modalSize');
      const modalColors = document.getElementById('modalColors');
      const modalAddBtn = document.getElementById('modalAddBtn');
      const closeModal = () => { modal.style.display = 'none'; };
      document.getElementById('closeModal').addEventListener('click', closeModal);
      document.getElementById('modalCloseBtn').addEventListener('click', closeModal);

      window.openProductModal = function(productId, title, price, image, promoPercentage = null, originalPrice = null){
        modalTitle.textContent = title;
        
        // Gérer l'affichage des prix avec promotion
        const modalPromoBadge = document.getElementById('modalPromoBadge');
        if (promoPercentage && promoPercentage > 0) {
          if (originalPrice && originalPrice !== price) {
            // Cas d'une réduction automatique : afficher le prix actuel et le prix barré
            modalPrice.innerHTML = `
              <span style="color: #e74c3c; font-weight: 900; font-size: 1.1rem;">${parseFloat(price).toFixed(2)} $</span>
              <span style="color: #95a5a6; font-weight: 600; font-size: 0.9rem; text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: #e74c3c;">${parseFloat(originalPrice).toFixed(2)} $</span>
              <span style="background: linear-gradient(135deg, #ff4757, #ff3742); color: #fff; font-weight: 900; padding: 4px 8px; border-radius: 12px; font-size: 10px; margin-left: 8px; box-shadow: 0 2px 6px rgba(255, 71, 87, 0.4); text-transform: uppercase; letter-spacing: 0.3px; border: 1px solid #fff;">-${promoPercentage}%</span>
            `;
          } else {
            // Cas d'une vraie promotion : calculer le prix promo
            const promoPrice = (parseFloat(price) * (100 - promoPercentage) / 100).toFixed(2);
            modalPrice.innerHTML = `
              <span style="color: #e74c3c; font-weight: 900; font-size: 1.1rem;">${promoPrice} $</span>
              <span style="color: #95a5a6; font-weight: 600; font-size: 0.9rem; text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: #e74c3c;">${price} $</span>
              <span style="background: linear-gradient(135deg, #ff4757, #ff3742); color: #fff; font-weight: 900; padding: 4px 8px; border-radius: 12px; font-size: 10px; margin-left: 8px; box-shadow: 0 2px 6px rgba(255, 71, 87, 0.4); text-transform: uppercase; letter-spacing: 0.3px; border: 1px solid #fff;">-${promoPercentage}%</span>
            `;
          }
          modalPromoBadge.textContent = `-${promoPercentage}%`;
          modalPromoBadge.style.display = 'block';
        } else {
          modalPrice.textContent = price + ' $';
          modalPromoBadge.style.display = 'none';
        }
        
        // Utiliser l'image de l'article de base si aucune image spécifique n'est fournie
        modalImage.src = image && image.trim() !== '' ? '/uploads/' + image : '/uploads/default-product.jpg';

        // populate sizes
        const sizesJson = document.querySelector(`.sizes-json[data-product-id="${productId}"]`);
        let sizes = [];
        try { sizes = sizesJson ? JSON.parse(sizesJson.textContent || '[]') : []; } catch(e) { sizes = []; }
        modalSize.innerHTML = '';
        const defaultOpt = document.createElement('option'); defaultOpt.value=''; defaultOpt.textContent='Sélectionner'; modalSize.appendChild(defaultOpt);
        sizes.forEach(s => { const o = document.createElement('option'); o.value = s.id; o.textContent = s.value; modalSize.appendChild(o); });

        // populate colors for first size (if available)
        const colorsJson = document.querySelector(`.colors-json[data-product-id="${productId}"]`);
        let colorsMap = {};
        try { colorsMap = colorsJson ? JSON.parse(colorsJson.textContent || '{}') : {}; } catch(e){ colorsMap = {}; }
        console.log('ColorsMap for product', productId, ':', colorsMap);
        console.log('Available size keys in colorsMap:', Object.keys(colorsMap));
        const firstSize = sizes.length ? sizes[0].id : null;
        console.log('First size ID:', firstSize);
        console.log('Colors for first size:', colorsMap[firstSize]);
        
        // Essayer de trouver une taille qui a des couleurs
        let sizeWithColors = null;
        for (const sizeId of Object.keys(colorsMap)) {
          if (colorsMap[sizeId] && colorsMap[sizeId].length > 0) {
            sizeWithColors = sizeId;
            break;
          }
        }
        console.log('Size with colors found:', sizeWithColors);
        
        // Utiliser la première taille avec des couleurs, ou la première taille disponible
        const targetSize = sizeWithColors || firstSize;
        populateModalColors(colorsMap[targetSize] || []);

        modal.style.display = 'flex';

        modalSize.onchange = () => {
          const sz = modalSize.value;
          console.log('Size changed to:', sz);
          console.log('Colors for selected size:', colorsMap[sz]);
          populateModalColors(colorsMap[sz] || []);
        };

        function populateModalColors(list){
          console.log('populateModalColors called with:', list);
          modalColors.innerHTML = '';
          if (!list || list.length === 0) {
            modalColors.innerHTML = '<div class="text-muted">Aucune couleur</div>';
            return;
          }
          list.forEach(c => {
            const el = document.createElement('div'); el.className = 'color-item'; el.style.cursor='pointer'; el.dataset.colorId = c.id; el.title = c.name || '';
            if (c.image) { const img = document.createElement('img'); img.src = c.image; img.style.width='36px'; img.style.height='36px'; img.style.objectFit='cover'; img.style.borderRadius='6px'; el.appendChild(img); }
            else { const sw = document.createElement('span'); sw.className='color-swatch'; sw.style.background = c.name || '#ccc'; el.appendChild(sw); }
            el.onclick = () => { 
              modalColors.querySelectorAll('.color-item').forEach(x=>x.classList.remove('active')); 
              el.classList.add('active');
              // Mettre à jour l'image du modal si l'image de couleur existe
              if (c.image) {
                modalImage.src = c.image;
              }
            };
            modalColors.appendChild(el);
          });
        }

        modalAddBtn.onclick = async () => {
          const selectedSize = modalSize.value || null;
          const selectedColorEl = modalColors.querySelector('.color-item.active');
          const selectedColor = selectedColorEl ? selectedColorEl.dataset.colorId : null;
          // call existing addToBag (overridden) by constructing a fake button to show UX
          modalAddBtn.disabled = true; modalAddBtn.textContent = 'Ajout...';
          const fakeBtn = document.createElement('button');
          document.body.appendChild(fakeBtn);
          // reuse addToBag override which reads modal DOM if present
          // build params and POST directly to keep behavior consistent
          const params = new URLSearchParams();
          params.append('name', title);
          params.append('price', price);
          params.append('images', image);
          params.append('quantity', '1');
          if (selectedSize) params.append('itemSizeId', selectedSize);
          if (selectedColor) params.append('colorId', selectedColor);

          try {
            const res = await fetch(`/client/add-cart/${productId}`, { method: 'POST', headers: { 'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest' }, body: params.toString() });
            if (!res.ok) throw new Error('err');
            modalAddBtn.textContent = 'Ajouté !';
            setTimeout(closeModal, 700);
          } catch(e){ modalAddBtn.textContent = 'Erreur'; }
          modalAddBtn.disabled = false;
        };
      };
    })();
    </script>
  </body>
</html>