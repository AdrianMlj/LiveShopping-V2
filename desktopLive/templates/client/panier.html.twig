{# Page Panier Client #}
{% include 'components/navbarClient.html.twig' %}

{% block content %}
<div class="cart-container">
    {% if cart|length == 0 %}
        <div class="cart-empty">
            <div class="empty-icon">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <h2>Votre panier est vide</h2>
            <p>Commencez à ajouter des produits pour continuer vos achats</p>
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                <i class="fa-solid fa-bag-shopping"></i>
                Découvrir nos produits
            </a>
        </div>
    {% else %}
    <div class="cart-wrapper">
        {# Colonne gauche : produits #}
        <div class="cart-left">
            <div class="cart-header">
                <h1 class="cart-title">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Votre Panier
                    <span class="cart-count">({{ cart|length }} article{{ cart|length > 1 ? 's' : '' }})</span>
                </h1>
                <a href="{{ path('app_home') }}" class="continue-shopping">
                    <i class="fa-solid fa-arrow-left"></i>
                    Continuer mes achats
                </a>
            </div>

            <div class="cart-items">
                {% for item in cart %}
                <div class="cart-item" data-item-id="{{ item.id }}">
                    <div class="item-image">
                        {% if item.images %}
                            <img src="/uploads/{{ item.images }}" alt="{{ item.name }}" class="product-image" loading="lazy">
                        {% else %}
                            <div class="product-image-placeholder">
                                <i class="fa-solid fa-image"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="item-details">
                        <div class="item-info">
                            <h3 class="item-name">{{ item.name }}</h3>
                            <p class="item-price-unit">{{ item.price|number_format(2, '.', ' ') }} €/unité</p>
                        </div>
                        
                        <div class="item-controls">
                            <div class="quantity-controls">
                                <button class="qty-btn minus" data-id="{{ item.id }}" aria-label="Réduire la quantité">
                                    <span class="fa-solid fa-minus">-</span>
                                </button>
                                <input type="number" value="{{ item.quantity }}" min="1" class="qty-input" 
                                       data-id="{{ item.id }}" aria-label="Quantité">
                                <button class="qty-btn plus" data-id="{{ item.id }}" aria-label="Augmenter la quantité">
                                    <span class="fa-solid fa-plus">+</span>
                                </button>
                            </div>
                            
                            <div class="item-total">
                                <span class="total-label">Total :</span>
                                <strong class="total-price">{{ (item.price * item.quantity)|number_format(2, '.', ' ') }} €</strong>
                            </div>
                        </div>
                    </div>
                    
                    <form method="post" action="{{ path('app_client_remove_cart', {'id': item.id}) }}" class="remove-form">
                        <button type="submit" class="btn-remove" data-id="{{ item.id }}" title="Supprimer l'article">
                            <span class="fa-solid fa-trash-can">❌</span>
                        </button>
                    </form>
                </div>
                {% endfor %}
            </div>

            <div class="cart-summary">
                <div class="summary-item">
                    <span>Sous-total</span>
                    <span>{{ cartTotal|number_format(2, '.', ' ') }} €</span>
                </div>
                <div class="summary-item">
                    <span>Frais de livraison</span>
                    <span class="free-shipping">Gratuit</span>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-total">
                    <span>Total TTC</span>
                    <strong>{{ cartTotal|number_format(2, '.', ' ') }} €</strong>
                </div>
            </div>
        </div>

        {# Sidebar paiement #}
        <div class="cart-right">
            <button class="toggle-sidebar" id="toggleSidebar">
                <i class="fa-solid fa-credit-card"></i>
                Paiement
            </button>
            <div class="payment-sidebar" id="paymentSidebar">
                <div class="payment-header">
                    <h3>
                        <i class="fa-solid fa-credit-card"></i>
                        Paiement sécurisé
                    </h3>
                    <div class="secure-badge">
                        <i class="fa-solid fa-lock"></i>
                        Sécurisé
                    </div>
                </div>

                <form id="payment-form" class="payment-form">
                    <div class="form-section">
                        <label class="section-label">Moyen de paiement</label>
                        <div class="payment-methods">
                            <div class="payment-method">
                                <input type="radio" id="mvola" name="payment" value="mvola" checked>
                                <label for="mvola" class="method-card">
                                    <div class="method-icon mvola">
                                        <i class="fa-solid fa-mobile-screen"></i>
                                    </div>
                                    <div class="method-info">
                                        <span class="method-name">Mvola</span>
                                        <span class="method-desc">Paiement mobile</span>
                                    </div>
                                </label>
                            </div>
                            <div class="payment-method">
                                <input type="radio" id="orange" name="payment" value="orange">
                                <label for="orange" class="method-card">
                                    <div class="method-icon orange">
                                        <i class="fa-solid fa-mobile-screen"></i>
                                    </div>
                                    <div class="method-info">
                                        <span class="method-name">Orange Money</span>
                                        <span class="method-desc">Paiement mobile</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <label for="phone" class="section-label">Numéro de téléphone</label>
                        <div class="input-group">
                            <span class="input-prefix">+261</span>
                            <input type="tel" id="phone" class="form-input" 
                                   placeholder="34 12 345 67" pattern="[0-9]{9}" required>
                        </div>
                    </div>

                    <div class="form-section">
                        <label for="code" class="section-label">Code de confirmation</label>
                        <input type="text" id="code" class="form-input" 
                               placeholder="Entrez le code reçu par SMS" required>
                        <small class="input-hint">
                            <i class="fa-solid fa-info-circle"></i>
                            Un code de confirmation sera envoyé à votre numéro
                        </small>
                    </div>

                    <div class="payment-actions">
                        <button type="submit" class="btn-payment">
                            <i class="fa-solid fa-lock"></i>
                            Payer {{ cartTotal|number_format(2, '.', ' ') }} €
                        </button>
                        
                        <div class="payment-security">
                            <div class="security-features">
                                <span class="security-item">
                                    <i class="fa-solid fa-shield-check"></i>
                                    Paiement 100% sécurisé
                                </span>
                                <span class="security-item">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    Retour facile sous 30 jours
                                </span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<style>
/* ===== VARIABLES ===== */
:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-light: #dbeafe;
    --secondary: #f59e0b;
    --secondary-dark: #d97706;
    --success: #10b981;
    --danger: #ef4444;
    --danger-dark: #dc2626;
    --warning: #f59e0b;
    --dark: #1f2937;
    --dark-light: #374151;
    --light: #f8fafc;
    --gray: #6b7280;
    --gray-light: #e5e7eb;
    --border: #d1d5db;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --radius: 12px;
    --radius-sm: 8px;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ===== BASE STYLES ===== */
.cart-container {
    max-width: 1400px;
    margin: 100px auto 40px;
    padding: 0 20px;
    min-height: calc(100vh - 140px);
}

/* ===== PANIER VIDE ===== */
.cart-empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--light);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.empty-icon {
    width: 100px;
    height: 100px;
    background: var(--primary-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
}

.empty-icon i {
    font-size: 3rem;
    color: var(--primary);
}

.cart-empty h2 {
    font-size: 2rem;
    color: var(--dark);
    margin-bottom: 1rem;
    font-weight: 700;
}

.cart-empty p {
    color: var(--gray);
    font-size: 1.1rem;
    margin-bottom: 2rem;
}

.btn-primary {
    background: var(--primary);
    color: white;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition);
    border: none;
    cursor: pointer;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

/* ===== LAYOUT PRINCIPAL ===== */
.cart-wrapper {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 30px;
    align-items: start;
}

/* ===== COLONNE GAUCHE ===== */
.cart-left {
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
}

.cart-header {
    padding: 2rem;
    border-bottom: 1px solid var(--gray-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
}

.cart-title {
    font-size: 1.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
}

.cart-count {
    font-size: 1rem;
    opacity: 0.9;
    font-weight: 500;
}

.continue-shopping {
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-sm);
    transition: var(--transition);
}

.continue-shopping:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(-4px);
}

/* ===== ARTICLES DU PANIER ===== */
.cart-items {
    padding: 0;
}

.cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 20px;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--gray-light);
    transition: var(--transition);
    position: relative;
}

.cart-item:hover {
    background: #fafafa;
}

.cart-item:last-child {
    border-bottom: none;
}

.item-image {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--gray-light);
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
}

.cart-item:hover .product-image {
    transform: scale(1.05);
}

.product-image-placeholder {
    color: var(--gray);
    font-size: 2rem;
}

.item-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.item-info h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--dark);
    margin: 0 0 4px 0;
}

.item-price-unit {
    color: var(--primary);
    font-weight: 500;
    margin: 0;
}

.item-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 8px;
}

.qty-btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    background: white;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    color: var(--dark);
}

.qty-btn:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

.qty-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.qty-btn:disabled:hover {
    background: white;
    color: var(--dark);
    border-color: var(--border);
}

.qty-input {
    width: 60px;
    height: 36px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
}

.qty-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.item-total {
    text-align: right;
}

.total-label {
    display: block;
    font-size: 0.9rem;
    color: var(--gray);
    margin-bottom: 4px;
}

.total-price {
    font-size: 1.3rem;
    color: var(--dark);
    font-weight: 700;
}

.remove-form {
    align-self: center;
}

.btn-remove {
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
}

.btn-remove:hover {
    background: rgba(216, 1, 1, 1);
    transform: scale(1.1);
}

/* ===== RÉSUMÉ DU PANIER ===== */
.cart-summary {
    padding: 2rem;
    background: var(--light);
    border-top: 1px solid var(--gray-light);
}

.summary-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    color: var(--dark);
}

.free-shipping {
    color: var(--success);
    font-weight: 600;
}

.summary-divider {
    height: 1px;
    background: var(--border);
    margin: 1rem 0;
}

.summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary);
}

/* ===== SIDEBAR PAIEMENT ===== */
.cart-right {
    position: relative;
}

.toggle-sidebar {
    width: 100%;
    background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: var(--radius-sm);
    font-size: 1.2rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow);
    position: sticky;
    top: 100px;
    z-index: 10;
}

.toggle-sidebar:hover {
    background: var(--dark-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.toggle-sidebar i {
    transition: transform 0.3s ease;
}

.payment-sidebar {
    background: var(--dark);
    color: var(--light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 1.5rem 2rem;
    position: fixed;
    top: 120px;
    right: -400px;
    width: 350px;
    height: calc(100vh - 180px);
    overflow-y: auto;
    transition: right 0.3s ease;
    z-index: 1000;
}

.payment-sidebar.active {
    right: 20px;
}

.payment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gray-light);
    margin-bottom: 1.5rem;
}

.payment-header h3 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.3rem;
    color: var(--secondary);
}

.secure-badge {
    background: var(--success);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
}

.payment-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-section {
    margin-bottom: 0;
}

.section-label {
    display: block;
    font-weight: 600;
    color: var(--light);
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
}

.payment-methods {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.payment-method input[type="radio"] {
    display: none;
}

.method-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 2px solid var(--gray-light);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
    background: var(--dark-light);
}

.payment-method input[type="radio"]:checked + .method-card {
    border-color: var(--secondary);
    background: rgba(245, 158, 11, 0.1);
}

.method-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: white;
}

.method-icon.mvola { background: #8b5cf6; }
.method-icon.orange { background: #ff6b00; }

.method-info {
    display: flex;
    flex-direction: column;
}

.method-name {
    font-weight: 600;
    color: var(--light);
}

.method-desc {
    font-size: 0.8rem;
    color: var(--gray);
}

.input-group {
    display: flex;
}

.input-prefix {
    background: var(--dark-light);
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-right: none;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    color: var(--gray);
    font-weight: 500;
}

.form-input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    background: var(--dark-light);
    color: var(--light);
    transition: var(--transition);
}

.form-input:focus {
    outline: none;
    border-color: var(--secondary);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
}

.input-group .form-input {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.input-hint {
    color: var(--gray);
    font-size: 0.8rem;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
}

/* ===== BOUTONS DE PAIEMENT ===== */
.payment-actions {
    margin-top: 2rem;
}

.btn-payment {
    width: 100%;
    background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
    color: white;
    border: none;
    padding: 16px;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: var(--transition);
    margin-bottom: 1rem;
}

.btn-payment:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.payment-security {
    text-align: center;
}

.security-features {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--gray);
}

.security-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

/* ===== ANIMATIONS ===== */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.cart-item {
    animation: slideIn 0.3s ease-out;
}

.cart-item.removing {
    animation: slideOut 0.3s ease-in forwards;
}

@keyframes slideOut {
    to {
        opacity: 0;
        transform: translateX(-100%);
        height: 0;
        padding: 0;
        margin: 0;
        border: none;
    }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .cart-wrapper {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .cart-right {
        position: static;
    }
    
    .payment-sidebar {
        position: static;
        width: 100%;
        height: auto;
        right: 0;
        top: 0;
        margin-top: 20px;
    }
    
    .payment-sidebar.active {
        right: 0;
    }
    
    .toggle-sidebar {
        display: none;
    }
}

@media (max-width: 768px) {
    .cart-container {
        margin-top: 80px;
        padding: 0 15px;
    }
    
    .cart-header {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }
    
    .cart-item {
        grid-template-columns: 80px 1fr;
        gap: 15px;
        padding: 1rem;
    }
    
    .item-controls {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }
    
    .item-total {
        text-align: left;
    }
    
    .btn-remove {
        position: absolute;
        top: 1rem;
        right: 1rem;
    }
    
    .payment-methods {
        flex-direction: column;
    }
}

@media (max-width: 480px) {
    .cart-item {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .item-image {
        margin: 0 auto;
    }
    
    .item-controls {
        align-items: center;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des quantités
    const qtyButtons = document.querySelectorAll('.qty-btn');
    
    qtyButtons.forEach(button => {
        button.addEventListener('click', function() {
            const itemId = this.getAttribute('data-id');
            const input = document.querySelector(`.qty-input[data-id="${itemId}"]`);
            let currentValue = parseInt(input.value);
            
            if (this.classList.contains('plus')) {
                input.value = currentValue + 1;
            } else if (this.classList.contains('minus') && currentValue > 1) {
                input.value = currentValue - 1;
            }
            
            // Ici, vous pouvez ajouter une requête AJAX pour mettre à jour la quantité en base de données
            updateQuantity(itemId, input.value);
        });
    });
    
    // Mise à jour de la quantité lors de la modification manuelle
    const qtyInputs = document.querySelectorAll('.qty-input');
    qtyInputs.forEach(input => {
        input.addEventListener('change', function() {
            const itemId = this.getAttribute('data-id');
            if (this.value < 1) this.value = 1;
            
            // Mise à jour de la quantité
            updateQuantity(itemId, this.value);
        });
    });
    
    function updateQuantity(itemId, quantity) {
