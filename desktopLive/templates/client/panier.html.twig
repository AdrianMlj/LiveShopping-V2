    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.checkout-header h3 {
    font-size: 1.3rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
}

.secure-badge {
    background: var(--success);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
