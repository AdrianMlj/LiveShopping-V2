    align-items: center;
    gap: 6px;
}

.input-with-prefix {
    display: flex;
}

.input-prefix {
    background: var(--light);
    padding: 12px 15px;
    border: 1px solid var(--border);
    border-right: none;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    color: var(--gray);
    font-weight: 500;
}

.form-input {
    flex: 1;
    padding: 12px 15px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    transition: var(--transition);
}

.form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
}

.input-with-prefix .form-input {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.form-hint {
    color: var(--gray);
    font-size: 0.8rem;
    margin-top: 6px;
    display: block;
}

/* Checkout Actions */
.btn-checkout {
    width: 100%;
    background: var(--gradient-primary);
    color: white;
    border: none;
    padding: 18px;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.btn-checkout:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
}

.security-features {
    margin-top: 20px;
