}

@keyframes priceUpdate {
    0% { background: rgba(124, 58, 237, 0.2); }
    100% { background: none; }
}

.btn-remove {
    background: var(--danger);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
