    flex-direction: column;
}

.method-name {
    font-weight: 600;
    color: var(--dark);
}

.method-desc {
    font-size: 0.8rem;
    color: var(--gray);
}

.radio-indicator {
    width: 20px;
    height: 20px;
    border: 2px solid var(--gray-light);
    border-radius: 50%;
    transition: var(--transition);
}

.payment-radio:checked + .method-label .radio-indicator {
    border-color: var(--primary);
    background: var(--primary);
    box-shadow: inset 0 0 0 3px white;
}

/* Payment Fields */
.payment-fields {
    margin-bottom: 25px;
    transition: var(--transition);
}

.form-group {
    margin-bottom: 20px;
}

.form-label {
