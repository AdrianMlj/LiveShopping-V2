.summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary);
}

/* Checkout Sidebar */
.checkout-sidebar {
    position: sticky;
    top: 100px;
}

.checkout-card {
    background: white;
    border-radius: var(--radius);
