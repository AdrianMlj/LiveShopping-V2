{% include 'components/navbarClient.html.twig' %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

{% block content %}
<div class="shopping-cart">
    {% if cart|length == 0 %}
        <div class="empty-cart">
            <div class="empty-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h2>Votre panier vous attend</h2>
            <p>Il semble un peu vide... Ajoutez vos produits préférés pour commencer vos achats</p>
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                <i class="fa-solid fa-bag-shopping"></i>
                Découvrir les produits
            </a>
        </div>
    {% else %}
    <div class="cart-layout">
        <!-- Main Cart Section -->
        <div class="cart-main">
            <div class="cart-header-section">
                <div class="header-background"></div>
                <div class="header-content">
                    <h1 class="page-title">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Mon Panier
                        <span class="item-count">({{ cart|length }} article{{ cart|length > 1 ? 's' : '' }})</span>
                    </h1>
                    <a href="{{ path('app_home') }}" class="continue-shopping-btn">
                        <i class="fa-solid fa-arrow-left"></i>
                        Continuer mes achats
                    </a>
                </div>
                <div class="progress-indicator">
                    <div class="progress-steps">
                        <div class="step active" id="step-cart">
                            <div class="step-number">1</div>
                            <span>Panier</span>
                        </div>
                        <div class="step" id="step-shipping">
                            <div class="step-number">2</div>
                            <span>Livraison</span>
                        </div>
                        <div class="step" id="step-payment">
                            <div class="step-number">3</div>
                            <span>Paiement</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cart Items -->
            <div class="cart-items-section">
                {% for item in cart %}
                <div class="cart-item-card" data-cart-key="{{ item.cart_key|default(item.id) }}" data-price="{{ item.price }}">
                    <!-- Product Image -->
                    <div class="product-image-container">
                        {% set displayImage = null %}
                        {% if item.colorImage is defined and item.colorImage %}
                            {% set displayImage = item.colorImage %}
                        {% elseif item.images %}
                            {% set displayImage = item.images %}
                        {% endif %}
                        {% if displayImage %}
                            <img src="/Uploads/{{ displayImage }}" alt="{{ item.name }}" class="product-image" loading="lazy">
                        {% else %}
                            <div class="product-image-placeholder">
                                <i class="fa-solid fa-image"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Product Details -->
                    <div class="product-details">
                        <div class="product-info">
                            <h3 class="product-name">{{ item.name }}</h3>
                            <p class="product-price-unit">{{ item.price|number_format(0, ' ', ' ') }} Ar/unité</p>
                            
                            <div class="product-variants">
                                {% set sizes = sizesByItem[item.id]|default([]) %}
                                {% set selectedSize = null %}
                                {% for s in sizes %}
                                    {% if item.itemSizeId is defined and item.itemSizeId == s.id %}
                                        {% set selectedSize = s.label %}
                                    {% endif %}
                                {% endfor %}
                                
                                {% set selectedColor = null %}
                                {% set selectedColorImage = null %}
                                
                                {% set currentSizeId = item.itemSizeId ?? (sizes|length ? sizes[0].id : null) %}
                                {% set colors = currentSizeId ? (colorsBySize[currentSizeId]|default([])) : [] %}
                                {% for c in colors %}
                                    {% if item.colorId is defined and item.colorId == c.id %}
                                        {% set selectedColor = c.name %}
                                    {% endif %}
                                {% endfor %}
                                
                                {% if item.colorImage is defined and item.colorImage %}
                                    {% set selectedColorImage = '/Uploads/' ~ item.colorImage %}
                                {% endif %}
                                
                                {% if selectedSize or selectedColor %}
                                    <div class="variant-display">
                                        {% if selectedSize %}
                                            <div class="variant-item">
                                                <span class="variant-label">
                                                    <i class="fa-solid fa-ruler"></i>
                                                    Taille :
                                                </span>
                                                <span class="variant-value">{{ selectedSize }}</span>
                                            </div>
                                        {% endif %}
                                        {% if selectedColor %}
                                            <div class="variant-item">
                                                <span class="variant-label">
                                                    <i class="fa-solid fa-palette"></i>
                                                    Couleur :
                                                </span>
                                                {% if selectedColorImage %}
                                                    <img src="{{ selectedColorImage }}" alt="{{ selectedColor }}" class="color-preview" title="{{ selectedColor }}">
                                                {% else %}
                                                    <span class="variant-value">{{ selectedColor }}</span>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        
                        <!-- Quantity Controls -->
                        <div class="product-controls">
                            <div class="quantity-section">
                                <div class="quantity-controls">
                                    <button class="qty-btn decrease" data-cart-key="{{ item.cart_key|default(item.id) }}" aria-label="Réduire la quantité">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <input type="number" value="{{ item.quantity }}" min="1" class="qty-input" 
                                           data-cart-key="{{ item.cart_key|default(item.id) }}" aria-label="Quantité">
                                    <button class="qty-btn increase" data-cart-key="{{ item.cart_key|default(item.id) }}" aria-label="Augmenter la quantité">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                                
                                <div class="item-total">
                                    <span class="total-label">Sous-total :</span>
                                    <strong class="total-price">{{ (item.price * item.quantity)|number_format(0, ' ', ' ') }} Ar</strong>
                                </div>
                            </div>
                            
                            <!-- Remove Button -->
                            <form method="post" action="{{ path('app_client_remove_cart', {'cartKey': item.cart_key|default(item.id)}) }}" class="remove-form">
                                <button type="submit" class="btn-remove" data-cart-key="{{ item.cart_key|default(item.id) }}" title="Supprimer l'article">
                                    <i class="fa-solid fa-trash"></i>
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Cart Summary -->
            <div class="cart-summary-section">
                <div class="summary-card">
                    <h3 class="summary-title">Récapitulatif</h3>
                    <div class="summary-details">
                        <div class="summary-row">
                            <span>Sous-total ({{ cart|length }} article{{ cart|length > 1 ? 's' : '' }})</span>
                            <span>{{ cartTotal|number_format(0, ' ', ' ') }} Ar</span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-total">
                            <span>Total TTC</span>
                            <strong>{{ cartTotal|number_format(0, ' ', ' ') }} Ar</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checkout Sidebar -->
        <div class="checkout-sidebar" id="checkout-sidebar">
            <!-- Étape 1: Récapitulatif Panier -->
            <div class="checkout-card step-content active" id="step-cart-content">
                <div class="checkout-header">
                    <h3>
                        <i class="fa-solid fa-cart-shopping"></i>
                        Récapitulatif
                    </h3>
                </div>
                <div class="summary-details">
                    <div class="summary-row">
                        <span>Sous-total ({{ cart|length }} article{{ cart|length > 1 ? 's' : '' }})</span>
                        <span id="summary-subtotal">{{ cartTotal|number_format(0, ' ', ' ') }} Ar</span>
                    </div>
                    <div class="summary-divider"></div>
                    <div class="summary-total">
                        <span>Total TTC</span>
                        <strong id="summary-total-amount">{{ cartTotal|number_format(0, ' ', ' ') }} Ar</strong>
                    </div>
                    <div class="checkout-actions">
                        <button type="button" id="btn-next-shipping" class="btn-checkout">
                            Continuer vers la livraison
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Étape 2: Informations de livraison -->
            <div class="checkout-card step-content hidden" id="step-shipping-content">
                <div class="checkout-header">
                    <h3>
                        <i class="fa-solid fa-truck"></i>
                        Informations de livraison
                    </h3>
                </div>
                <form id="shipping-form" class="payment-form">
                    <div class="form-group">
                        <label for="delivery-name" class="form-label">
                            <i class="fa-solid fa-user"></i>
                            Nom complet
                        </label>
                        <input type="text" id="delivery-name" class="form-input" placeholder="Votre nom" required>
                    </div>
                    <div class="form-group">
                        <label for="delivery-phone" class="form-label">
                            <i class="fa-solid fa-phone"></i>
                            Téléphone
                        </label>
                        <div class="input-with-prefix">
                            <span class="input-prefix">+261</span>
                            <input type="tel" id="delivery-phone" class="form-input" placeholder="34 12 345 67" pattern="[0-9]{9}" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="delivery-address" class="form-label">
                            <i class="fa-solid fa-map-marker-alt"></i>
                            Adresse
                        </label>
                        <textarea id="delivery-address" class="form-input" rows="3" placeholder="Votre adresse complète" required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="delivery-city" class="form-label">
                            <i class="fa-solid fa-city"></i>
                            Ville
                        </label>
                        <input type="text" id="delivery-city" class="form-input" placeholder="Votre ville" required>
                    </div>
                    <div class="checkout-actions">
                        <button type="button" id="btn-next-payment" class="btn-checkout">
                            Continuer vers le paiement
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                        <button type="button" id="btn-back-cart" class="btn-secondary">
                            <i class="fa-solid fa-arrow-left"></i>
                            Retour
                        </button>
                    </div>
                </form>
            </div>

            <!-- Étape 3: Paiement -->
            <div class="checkout-card step-content hidden" id="step-payment-content">
                <div class="checkout-header">
                    <h3>
                        <i class="fa-solid fa-credit-card"></i>
                        Paiement
                    </h3>
                </div>

                <form id="payment-form" class="payment-form">
                    <!-- Payment Methods -->
                    <div class="payment-methods-section">
                        <label class="section-label">Moyen de paiement</label>
                        <div class="payment-methods-grid">
                            <div class="payment-method-card">
                                <input type="radio" id="mvola" name="payment" value="mvola" class="payment-radio">
                                <label for="mvola" class="method-label">
                                    <div class="method-icon mvola">
                                        <i class="fa-solid fa-mobile-screen"></i>
                                    </div>
                                    <div class="method-details">
                                        <span class="method-name">Mvola</span>
                                        <span class="method-desc">Paiement mobile</span>
                                    </div>
                                    <div class="radio-indicator"></div>
                                </label>
                            </div>
                            
                            <div class="payment-method-card">
                                <input type="radio" id="orange" name="payment" value="orange" class="payment-radio">
                                <label for="orange" class="method-label">
                                    <div class="method-icon orange">
                                        <i class="fa-solid fa-mobile-screen"></i>
                                    </div>
                                    <div class="method-details">
                                        <span class="method-name">Orange Money</span>
                                        <span class="method-desc">Paiement mobile</span>
                                    </div>
                                    <div class="radio-indicator"></div>
                                </label>
                            </div>

                            {# <div class="payment-method-card">
                                <input type="radio" id="cod" name="payment" value="cod" class="payment-radio">
                                <label for="cod" class="method-label">
                                    <div class="method-icon cod">
                                        <i class="fa-solid fa-truck"></i>
                                    </div>
                                    <div class="method-details">
                                        <span class="method-name">À la livraison</span>
                                        <span class="method-desc">Payez au livreur</span>
                                    </div>
                                    <div class="radio-indicator"></div>
                                </label>
                            </div> #}
                        </div>
                    </div>

                    <!-- Payment Fields -->
                    <div class="payment-fields" id="payment-fields">
                        <div class="form-group">
                            <label for="phone" class="form-label">
                                <i class="fa-solid fa-phone"></i>
                                Numéro de téléphone
                            </label>
                            <div class="input-with-prefix">
                                <span class="input-prefix">+261</span>
                                <input type="tel" id="phone" class="form-input" 
                                       placeholder="34 12 345 67" pattern="[0-9]{9}" required>
                            </div>
                        </div>
                        
                        <div class="form-group" id="code-group">
                            <label for="code" class="form-label">
                                <i class="fa-solid fa-sms"></i>
                                Code de confirmation
                            </label>
                            <input type="text" id="code" class="form-input" 
                                   placeholder="Entrez le code reçu par SMS" required>
                            <small class="form-hint">
                                Un code de confirmation sera envoyé à votre numéro
                            </small>
                        </div>

                        <div class="qr-section hidden" id="qr-section">
                            <label class="form-label">
                                <i class="fa-solid fa-qrcode"></i>
                                Scan QR pour payer
                            </label>
                            <div class="qr-actions" id="qr-actions"></div>
                            <div id="qr-container" class="qr-container"></div>
                            <div id="qr-status" class="qr-status"></div>
                        </div>
                    </div>

                    <!-- Checkout Actions -->
                    <div class="checkout-actions">
                        <button type="submit" id="btn-confirm-order" class="btn-checkout">
                            <i class="fa-solid fa-lock"></i>
                            Valider la commande
                        </button>
                        
                        <div class="security-features">
                            <div class="security-item">
                                <i class="fa-solid fa-shield-check"></i>
                                Paiement 100% sécurisé
                            </div>
                            <div class="security-item">
                                <i class="fa-solid fa-rotate-left"></i>
                                Retour facile sous 30 jours
                            </div>
                        </div>
                        
                        <button type="button" id="btn-back-shipping" class="btn-secondary">
                            <i class="fa-solid fa-arrow-left"></i>
                            Retour
                        </button>
                    </div>
                </form>
            </div>

            <!-- Étape 4: Confirmation -->
            <div class="checkout-card step-content hidden" id="step-confirmation-content">
                <div class="checkout-header">
                    <h3>
                        <i class="fa-solid fa-check-circle"></i>
                        Commande confirmée
                    </h3>
                </div>
                <div class="confirmation-content">
                    <div class="confirmation-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h4>Merci pour votre commande !</h4>
                    <p>Votre commande a été enregistrée avec succès.</p>
                    <div class="confirmation-details">
                        <div class="confirmation-row">
                            <span>Numéro de commande :</span>
                            <strong id="order-number">--</strong>
                        </div>
                        <div class="confirmation-row">
                            <span>Montant total :</span>
                            <strong id="order-total">--</strong>
                        </div>
                    </div>
                    <div class="checkout-actions">
                        <button type="button" id="btn-back-home" class="btn-checkout">
                            <i class="fa-solid fa-home"></i>
                            Retour à l'accueil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const codeGroup = document.getElementById('code-group');
    const codeInput = document.getElementById('code');
    const paymentFields = document.getElementById('payment-fields');
    const qrSection = document.getElementById('qr-section');
    const qrContainer = document.getElementById('qr-container');
    const qrStatus = document.getElementById('qr-status');
    const qrActions = document.getElementById('qr-actions');
    let currentQrTxId = null;
    let pollIntervalId = null;
    let isMockQR = false;
    let mockPaidAt = 0;

    // Gestion des étapes du panier
    let currentStep = 'cart';
    
    // Active/désactive la modification des articles
    function setCartEditable(isEditable) {
        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.disabled = !isEditable;
            btn.classList.toggle('disabled', !isEditable);
        });
        document.querySelectorAll('.qty-input').forEach(input => {
            input.disabled = !isEditable;
            input.classList.toggle('disabled', !isEditable);
        });
        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.disabled = !isEditable;
            btn.classList.toggle('disabled', !isEditable);
        });
        // Visuellement griser la section items
        const itemsSection = document.querySelector('.cart-items-section');
        if (itemsSection) {
            itemsSection.classList.toggle('locked', !isEditable);
        }
    }

    // Navigation entre étapes
    function showStep(step) {
        currentStep = step;
        document.querySelectorAll('.step-content').forEach(el => el.classList.add('hidden'));
        const stepContent = document.getElementById(`step-${step}-content`);
        if (stepContent) {
            stepContent.classList.remove('hidden');
        }
        
        // Désactiver les modifications de panier si on n'est plus à l'étape Panier
        setCartEditable(step === 'cart');
        
        // Mettre à jour l'indicateur visuel (sauf pour confirmation)
        if (step !== 'confirmation') {
            const stepElements = {
                'cart': document.getElementById('step-cart'),
                'shipping': document.getElementById('step-shipping'),
                'payment': document.getElementById('step-payment')
            };
            Object.keys(stepElements).forEach(key => {
                if (stepElements[key]) {
                    if (key === step) {
                        stepElements[key].classList.add('active');
                    } else {
                        stepElements[key].classList.remove('active');
                    }
                }
            });
        }
    }
    
    // Boutons de navigation
    const btnNextShipping = document.getElementById('btn-next-shipping');
    const btnBackCart = document.getElementById('btn-back-cart');
    const btnNextPayment = document.getElementById('btn-next-payment');
    const btnBackShipping = document.getElementById('btn-back-shipping');
    const btnBackHome = document.getElementById('btn-back-home');
    
    if (btnNextShipping) {
        btnNextShipping.addEventListener('click', () => showStep('shipping'));
    }
    if (btnBackCart) {
        btnBackCart.addEventListener('click', () => showStep('cart'));
    }
    if (btnNextPayment) {
        btnNextPayment.addEventListener('click', () => {
            const shippingForm = document.getElementById('shipping-form');
            if (shippingForm && shippingForm.checkValidity()) {
                showStep('payment');
            } else {
                shippingForm.reportValidity();
            }
        });
    }
    if (btnBackShipping) {
        btnBackShipping.addEventListener('click', () => showStep('shipping'));
    }
    if (btnBackHome) {
        btnBackHome.addEventListener('click', () => {
            window.location.href = '{{ path("app_home") }}';
        });
    }

    function applyPaymentUIState(methodValue) {
        const isCOD = methodValue === 'cod';
        const isWallet = methodValue === 'mvola' || methodValue === 'orange';
        if (isCOD) {
            paymentFields.style.opacity = '0.5';
            paymentFields.style.pointerEvents = 'none';
            codeGroup.classList.add('hidden');
            if (codeInput) codeInput.required = false;
            if (qrSection) qrSection.classList.add('hidden');
            stopQrPolling();
            resetQrUI();
        } else if (methodValue) {
            // Pour mvola/orange et autres méthodes en ligne: code SMS obligatoire, pas de QR
            paymentFields.style.opacity = '1';
            paymentFields.style.pointerEvents = 'all';
            if (qrSection) qrSection.classList.add('hidden');
            codeGroup.classList.remove('hidden');
            if (codeInput) codeInput.required = true;
            stopQrPolling();
            resetQrUI();
        } else {
            // Aucun moyen sélectionné
            paymentFields.style.opacity = '1';
            paymentFields.style.pointerEvents = 'all';
            codeGroup.classList.add('hidden');
            if (codeInput) codeInput.required = false;
            if (qrSection) qrSection.classList.add('hidden');
            stopQrPolling();
            resetQrUI();
        }
    }

    // État initial selon la sélection (aucune par défaut)
    const initiallyChecked = document.querySelector('.payment-radio:checked');
    applyPaymentUIState(initiallyChecked ? initiallyChecked.value : '');
    // Format Ariary: entier, séparateur d'espace
    function formatPrice(price) {
        const n = Math.round(parseFloat(price) || 0);
        return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    }

    // Mettre à jour l'affichage du sous-total et du total global
    function updateCartDisplay(cartKey, quantity) {
        const cartItem = document.querySelector(`.cart-item-card[data-cart-key="${cartKey}"]`);
        const price = parseFloat(cartItem.getAttribute('data-price'));
        const subTotalElement = cartItem.querySelector('.total-price');
        const subTotal = price * quantity;

        // Mettre à jour le sous-total de l'article
        subTotalElement.textContent = `${formatPrice(subTotal)} Ar`;
        subTotalElement.classList.add('updated');
        setTimeout(() => subTotalElement.classList.remove('updated'), 500);

        // Recalculer et mettre à jour le total global
        updateCartTotal();
    }

    // Recalculer le total global du panier
    function updateCartTotal() {
        let total = 0;
        document.querySelectorAll('.cart-item-card').forEach(item => {
            const price = parseFloat(item.getAttribute('data-price'));
            const quantity = parseInt(item.querySelector('.qty-input').value);
            total += price * quantity;
        });

        // Mettre à jour le récapitulatif (étape 1)
        const summaryTotal = document.getElementById('summary-total-amount');
        if (summaryTotal) {
            summaryTotal.textContent = `${formatPrice(total)} Ar`;
            summaryTotal.classList.add('updated');
            setTimeout(() => summaryTotal.classList.remove('updated'), 500);
        }
        const summarySubTotal = document.getElementById('summary-subtotal');
        if (summarySubTotal) {
            summarySubTotal.textContent = `${formatPrice(total)} Ar`;
        }

        // QR désactivé: pas de régénération de QR lors des changements de montant
    }

    // Gestion des quantités
    document.querySelectorAll('.qty-btn').forEach(button => {
        button.addEventListener('click', async function() {
            const cartKey = this.getAttribute('data-cart-key');
            const input = document.querySelector(`.qty-input[data-cart-key="${cartKey}"]`);
            let currentValue = parseInt(input.value);
            
            if (this.classList.contains('increase')) {
                input.value = currentValue + 1;
            } else if (this.classList.contains('decrease') && currentValue > 1) {
                input.value = currentValue - 1;
            }
            
            const newQuantity = parseInt(input.value);
            updateCartDisplay(cartKey, newQuantity);
            await updateQuantity(cartKey, newQuantity);
        });
    });

    // Mise à jour manuelle de la quantité
    document.querySelectorAll('.qty-input').forEach(input => {
        input.addEventListener('change', async function() {
            const cartKey = this.getAttribute('data-cart-key');
            if (this.value < 1) this.value = 1;
            const newQuantity = parseInt(this.value);
            updateCartDisplay(cartKey, newQuantity);
            await updateQuantity(cartKey, newQuantity);
        });
    });

    // Fonction pour envoyer la mise à jour de la quantité au serveur
    async function updateQuantity(cartKey, quantity) {
        try {
            const response = await fetch('/client/cart/update-quantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ cartKey, quantity })
            });
            const data = await response.json();
            if (data.success) {
                showNotification('Quantité mise à jour', 'success');
            } else {
                showNotification(data.message || 'Erreur lors de la mise à jour', 'error');
                // Revenir à la quantité précédente en cas d'erreur
                const input = document.querySelector(`.qty-input[data-cart-key="${cartKey}"]`);
                input.value = data.previousQuantity || 1;
                updateCartDisplay(cartKey, input.value);
            }
        } catch (error) {
            console.error('Erreur lors de la mise à jour de la quantité:', error);
            showNotification('Erreur lors de la mise à jour', 'error');
        }
    }

    // Gestion de la suppression
    document.querySelectorAll('.btn-remove').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const cartKey = this.dataset.cartKey;
            const cartItem = this.closest('.cart-item-card');
            const form = this.closest('.remove-form');
            
            // Animation de suppression
            cartItem.style.transform = 'translateX(-100%)';
            cartItem.style.opacity = '0';
            cartItem.style.transition = 'all 0.4s ease';
            
            setTimeout(() => {
                form.submit();
            }, 400);
        });
    });

    // Gestion des méthodes de paiement
    document.querySelectorAll('.payment-radio').forEach(radio => {
        radio.addEventListener('change', function() {
            applyPaymentUIState(this.value);
        });
    });

    // QR: génération et polling sans clic
    async function initiateQrPayment(methodValue) {
        try {
            const initResp = await fetch('/client/payment/qr/initiate', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ method: methodValue || '' })
            });
            const initData = await initResp.json();
            if (!initResp.ok || !initData || !initData.qrUrl || !initData.transactionId) {
                // Fallback démo
                createMockQr(methodValue);
                return;
            }
            currentQrTxId = initData.transactionId;
            renderQr(initData.qrUrl);
            setQrStatus('En attente de paiement sur votre mobile...');
            startQrPolling();
            isMockQR = false;
        } catch (e) {
            console.error('QR init error', e);
            // Fallback démo
            createMockQr(methodValue);
        }
    }

    function createMockQr(methodValue) {
        isMockQR = true;
        currentQrTxId = `mock-${Date.now()}`;
        const demoText = `DEMO-${methodValue || 'wallet'}-${currentQrTxId}`;
        renderQr(demoText);
        setQrStatus('Mode démo: scannez le QR pour simuler le paiement...', 'info');
        // Simulation: paiement validé après 6 secondes
        mockPaidAt = Date.now() + 6000;
        startQrPolling();
        // Astuce: clic sur le QR = payer immédiatement en démo
        qrContainer.onclick = () => { if (isMockQR) mockPaidAt = Date.now(); };
    }

    function renderQr(text) {
        // Inclure QRCode.js si pas présent
        if (typeof QRCode === 'undefined') {
            const s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
            s.onload = () => drawQr(text);
            document.head.appendChild(s);
        } else {
            drawQr(text);
        }
    }

    function drawQr(text) {
        qrContainer.innerHTML = '';
        // eslint-disable-next-line no-undef
        new QRCode(qrContainer, {
            text,
            width: 200,
            height: 200
        });
    }

    function setQrStatus(message, type = 'info') {
        qrStatus.textContent = message;
        qrStatus.className = `qr-status ${type}`;
    }

    function startQrPolling() {
        stopQrPolling();
        pollIntervalId = setInterval(checkQrStatus, 3000);
    }

    function stopQrPolling() {
        if (pollIntervalId) {
            clearInterval(pollIntervalId);
            pollIntervalId = null;
        }
    }

    function resetQrUI() {
        currentQrTxId = null;
        if (qrContainer) qrContainer.innerHTML = '';
        if (qrStatus) { qrStatus.textContent = ''; qrStatus.className = 'qr-status'; }
    }

    async function checkQrStatus() {
        if (!currentQrTxId) return;
        try {
            if (isMockQR) {
                if (Date.now() >= mockPaidAt) {
                    stopQrPolling();
                    setQrStatus('Paiement confirmé (démo). Finalisation...', 'success');
                    await finalizeOrderAfterPayment('qr');
                }
                return;
            }

            const resp = await fetch(`/client/payment/status?tx=${encodeURIComponent(currentQrTxId)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await resp.json();
            if (data && data.status === 'paid') {
                stopQrPolling();
                setQrStatus('Paiement confirmé. Finalisation en cours...', 'success');
                await finalizeOrderAfterPayment('qr');
            } else if (data && data.status === 'failed') {
                stopQrPolling();
                setQrStatus('Paiement refusé ou expiré. Veuillez régénérer le QR.', 'error');
            }
        } catch (e) {
            console.error('QR status error', e);
            // En cas d’erreur réseau, on ne casse pas le polling; un prochain tick peut réussir
        }
    }

    // Soumission du formulaire de paiement
    document.getElementById('payment-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        await processPayment();
    });

    // Size and color change events
    document.querySelectorAll('.size-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
            const itemId = e.target.getAttribute('data-item-id');
            const itemSizeId = e.target.value;
            if (!itemSizeId) return;
            const fd = new FormData();
            fd.append('itemId', itemId);
            fd.append('itemSizeId', itemSizeId);
            await fetch('/client/cart/update-size', { method: 'POST', body: fd });
            location.reload();
        });
    });

    document.querySelectorAll('.color-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
            const itemId = e.target.getAttribute('data-item-id');
            const colorId = e.target.value;
            if (!colorId) return;
            const fd = new FormData();
            fd.append('itemId', itemId);
            fd.append('colorId', colorId);
            await fetch('/client/cart/update-color', { method: 'POST', body: fd });
        });
    });

    function showConfirmation(orderData) {
        const orderNumber = document.getElementById('order-number');
        const orderTotal = document.getElementById('order-total');
        if (orderNumber) orderNumber.textContent = orderData.orderNumber || `CMD-${Date.now()}`;
        if (orderTotal) {
            const text = document.getElementById('summary-total-amount')?.textContent || '0';
            const numeric = text.replace(/[^\d]/g, '');
            const total = parseInt(numeric || '0', 10);
            orderTotal.textContent = `${formatPrice(total)} Ar`;
        }
        showStep('confirmation');
    }

    async function processPayment() {
        const formData = new FormData(document.getElementById('payment-form'));
        const paymentMethod = formData.get('payment');
        const phone = document.getElementById('phone')?.value.trim();
        const code = document.getElementById('code')?.value.trim();

        if (paymentMethod !== 'cod') {
            if (!phone || !code) {
                showNotification('Téléphone et code requis', 'warning');
                return;
            }
        }

        try {
            showNotification('Validation de votre commande...', 'info');
            const resp = await fetch('/client/checkout/submit', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ paymentMethod })
            });
            const data = await resp.json();
            if (data && data.success) {
                showConfirmation(data);
            } else {
                showNotification(data.message || 'Erreur lors de la commande', 'error');
            }
        } catch (error) {
            console.error('Erreur paiement:', error);
            // En mode démo, on simule quand même la confirmation
            if (paymentMethod === 'mvola' || paymentMethod === 'orange' || paymentMethod === 'cod') {
                showConfirmation({ orderNumber: `CMD-${Date.now()}` });
            } else {
                showNotification('Erreur lors de la commande', 'error');
            }
        }
    }

    async function finalizeOrderAfterPayment(method) {
        try {
            const resp = await fetch('/client/checkout/submit', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ paymentMethod: method })
            });
            const data = await resp.json();
            if (data && data.success) {
                showConfirmation(data);
            } else {
                // En mode démo, on simule quand même la confirmation
                showConfirmation({ orderNumber: `CMD-${Date.now()}` });
            }
        } catch (e) {
            console.error('Finalize order error', e);
            // En mode démo, on simule quand même la confirmation
            showConfirmation({ orderNumber: `CMD-${Date.now()}` });
        }
    }

    function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        notification.className = `notification ${type}`;
        notification.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check' : type === 'error' ? 'exclamation-triangle' : 'info'}"></i>
            <span>${message}</span>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => notification.classList.add('show'), 100);
        
        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

});
</script>

<style>
:root {
