/* Animations existantes */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(5deg); }
}

/* Responsive */
@media (max-width: 1024px) {
    .cart-layout {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .checkout-sidebar {
        position: static;
    }
}

@media (max-width: 768px) {
    .shopping-cart {
        margin-top: 60px;
        padding: 0 15px;
    }
    
    .cart-header-section {
        padding: 20px;
    }
    
    .header-content {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }
    
    .progress-steps {
        gap: 20px;
    }
    
    .cart-item-card {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .product-controls {
        flex-direction: column;
        gap: 15px;
        align-items: center;
    }
    
    .quantity-section {
        justify-content: space-between;
        width: 100%;
    }
    
    .product-variants {
        flex-direction: column;
    }
}

@media (max-width: 480px) {
    .empty-cart {
        padding: 60px 20px;
    }
    
    .empty-cart h2 {
        font-size: 2rem;
    }
    
    .progress-steps {
        flex-direction: column;
        gap: 15px;
    }
    
    .step {
        flex-direction: row;
        gap: 12px;
    }
    
    .checkout-card {
        padding: 20px;
    }
}
