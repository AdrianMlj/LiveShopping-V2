<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages - LiveShop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<style>
    :root {
        --primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --primary-dark: #5a67d8;
        --success: #48bb78;
        --warning: #ed8936;
        --danger: #f56565;
        --bg-primary: #f8fafc;
        --bg-secondary: #ffffff;
        --text-primary: #2d3748;
        --text-secondary: #718096;
        --border: #e2e8f0;
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --shadow-heavy: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --radius: 12px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --animation-duration: 0.4s;
    }

    body.dark-mode {
        --bg-primary: #1a202c;
        --bg-secondary: #2d3748;
        --text-primary: #f7fafc;
        --text-secondary: #a0aec0;
        --border: #4a5568;
        --shadow-light: 0 4px 6px -1px rgba(0, 0, 0, 0.2), 0 2px 4px -1px rgba(0, 0, 0, 0.1);
        --shadow-medium: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
        --shadow-heavy: 0 20px 25px -5px rgba(0, 0, 0, 0.4), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    body {
        background: var(--bg-primary);
        color: var(--text-primary);
        height: 100vh;
        overflow: hidden;
        transition: var(--transition);
    }

    .messages-container {
        display: flex;
        height: calc(100vh - 60px);
        background: linear-gradient(135deg, var(--bg-primary) 0%, #edf2f7 100%);
        animation: pageLoad 0.6s ease-out;
    }

    @keyframes pageLoad {
        from { opacity: 0; transform: scale(0.98); }
        to { opacity: 1; transform: scale(1); }
    }

    .conversations {
        width: 360px;
        background: var(--bg-secondary);
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-heavy);
        border-right: 1px solid var(--border);
        overflow: hidden;
    }

    .user-profile-header {
        padding: 24px;
        background: var(--primary);
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .user-profile-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.1;
    }

    .user-avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.2);
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        transition: var(--transition);
        animation: avatarFloat 3s ease-in-out infinite;
        position: relative;
        z-index: 1;
    }

    @keyframes avatarFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-5px); }
    }

    .user-avatar-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .user-name {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .user-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .status-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--success);
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(72, 187, 120, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(72, 187, 120, 0); }
        100% { box-shadow: 0 0 0 0 rgba(72, 187, 120, 0); }
    }

    .search-section {
        padding: 20px;
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border);
    }

    .search-input-wrapper {
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 12px 16px 12px 45px;
        border: 2px solid var(--border);
        border-radius: var(--radius);
        font-size: 0.95rem;
        background: var(--bg-primary);
        transition: var(--transition);
        outline: none;
    }

    .search-input:focus {
        border-color: var(--primary-dark);
        box-shadow: 0 0 0 3px rgba(86, 122, 244, 0.1);
    }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    .conversations-list {
        flex: 1;
        overflow-y: auto;
        background: var(--bg-secondary);
    }

    .conversation-item {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        cursor: pointer;
        transition: var(--transition);
        border-bottom: 1px solid var(--border);
        position: relative;
        overflow: hidden;
    }

    .conversation-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: transparent;
        transition: var(--transition);
    }

    .conversation-item:hover {
        background: rgba(86, 122, 244, 0.05);
        transform: translateX(4px);
    }

    .conversation-item.active {
        background: rgba(86, 122, 244, 0.1);
    }

    .conversation-item.active::before {
        background: var(--primary-dark);
    }

    .conversation-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        margin-right: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 600;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        box-shadow: var(--shadow-light);
        transition: var(--transition);
    }

    .conversation-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .conversation-content {
        flex: 1;
        min-width: 0;
    }

    .conversation-name {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 4px;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-preview {
        font-size: 0.85rem;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
    }

    .unread-badge {
        background: var(--danger);
        color: white;
        border-radius: 12px;
        padding: 2px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 12px;
        animation: badgeBounce 0.6s ease-out;
    }

    @keyframes badgeBounce {
        0% { transform: scale(0.8); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }

    .conversation-time {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-left: 12px;
        white-space: nowrap;
    }

    .chat-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--bg-primary);
        position: relative;
        overflow: hidden;
    }

    .chat-header {
        display: flex;
        align-items: center;
        padding: 20px 24px;
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-light);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .chat-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        margin-right: 30px;
        margin-bottom: 16px;
        padding-top: 8px;
        padding-left: 15px;
    }

    .chat-user-info {
        flex: 1;
    }

    .chat-user-name {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .chat-user-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .chat-actions {
        display: flex;
        gap: 16px;
    }

    .chat-action-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.05);
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        font-size: 1.1rem;
    }

    .chat-action-btn:hover {
        background: var(--primary-dark);
        color: white;
        transform: scale(1.1);
    }

    .messages-area {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column-reverse;
        gap: 16px;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="%23e2e8f0" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>') var(--bg-primary);
        background-size: 20px 20px;
        scroll-behavior: smooth;
    }

    .message-wrapper {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        max-width: 80%;
        animation: messageSlide var(--animation-duration) ease-out;
    }

    @keyframes messageSlide {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .message-bubble {
        padding: 12px 16px;
        border-radius: var(--radius);
        position: relative;
        max-width: 100%;
        word-wrap: break-word;
        box-shadow: var(--shadow-light);
        transition: var(--transition);
    }

    .message-bubble.received {
        background: var(--bg-secondary);
        border-bottom-left-radius: 4px;
        color: var(--text-primary);
    }

    .message-bubble.sent {
        background: var(--primary);
        color: white;
        border-bottom-right-radius: 4px;
        margin-left: 100%;
    }

    .message-content {
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .message-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
        font-size: 0.75rem;
        opacity: 0.7;
    }

    .message-time.sent {
        margin-left: auto;
    }

    .message-status {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.7rem;
    }

    .status-icon {
        font-size: 0.8rem;
    }

    .typing-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 12px 16px;
        background: var(--bg-secondary);
        border-radius: var(--radius);
        border-bottom-left-radius: 4px;
        font-style: italic;
        color: var(--text-secondary);
    }

    .typing-dots {
        display: flex;
        gap: 4px;
    }

    .typing-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-secondary);
        animation: typing 1.4s infinite ease-in-out;
    }

    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }

    @keyframes typing {
        0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
        40% { transform: scale(1); opacity: 1; }
    }

    .input-section {
        padding: 20px 24px;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border);
        box-shadow: var(--shadow-light);
    }

    .input-wrapper {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        background: var(--bg-primary);
        padding: 12px;
        border-radius: var(--radius);
        border: 2px solid var(--border);
        transition: var(--transition);
    }

    .input-wrapper:focus-within {
        border-color: var(--primary-dark);
        box-shadow: 0 0 0 3px rgba(86, 122, 244, 0.1);
    }

    .input-actions-left, .input-actions-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .input-action {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.05);
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        font-size: 1.1rem;
    }

    .input-action:hover {
        background: var(--primary-dark);
        color: white;
        transform: scale(1.05) rotate(5deg);
    }

    .message-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 8px 12px;
        font-size: 0.95rem;
        background: transparent;
        resize: none;
        max-height: 100px;
        line-height: 1.4;
    }

    .emoji-picker {
        position: absolute;
        bottom: 100%;
        left: 0;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 10px;
        display: none;
        z-index: 10;
        box-shadow: var(--shadow-medium);
    }

    .emoji-picker.active {
        display: block;
    }

    .emoji-button {
        font-size: 1.2rem;
        padding: 5px;
        cursor: pointer;
        transition: var(--transition);
    }

    .emoji-button:hover {
        background: rgba(0, 0, 0, 0.05);
        border-radius: 50%;
    }

    .send-button {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: var(--primary);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        transition: var(--transition);
        animation: pulse 2s infinite;
    }

    .send-button:hover {
        background: var(--primary-dark);
        transform: scale(1.1);
    }

    .send-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        animation: none;
    }

    .no-conversation {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--text-secondary);
        animation: fadeIn 0.5s ease-out;
    }

    .no-conversation-icon {
        font-size: 4rem;
        margin-bottom: 16px;
        opacity: 0.5;
        animation: iconBounce 2s infinite;
    }

    @keyframes iconBounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }

    .no-conversation-text {
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    .no-conversation-subtext {
        font-size: 0.9rem;
        opacity: 0.8;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .messages-container {
            flex-direction: column;
        }

        .conversations {
            width: 100%;
            height: 40%;
        }

        .chat-container {
            height: 60%;
        }

        .user-avatar-large {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }

        .conversation-avatar {
            width: 44px;
            height: 44px;
            font-size: 1.2rem;
        }

        .messages-area {
            padding: 16px;
            gap: 12px;
        }

        .message-wrapper {
            max-width: 90%;
            gap: 8px;
        }

        .input-wrapper {
            padding: 8px;
            gap: 8px;
        }

        .input-action, .send-button {
            width: 36px;
            height: 36px;
            font-size: 1rem;
        }

        .emoji-picker {
            width: 200px;
        }
    }

    @media (max-width: 480px) {
        .conversations {
            height: 35%;
        }

        .chat-container {
            height: 65%;
        }

        .search-section {
            padding: 16px;
        }

        .chat-header {
            padding: 16px 20px;
        }

        .input-section {
            padding: 16px 20px;
        }
    }

    /* Scrollbar custom */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg-primary);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--text-secondary);
        border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--primary-dark);
    }

    /* Loading spinner */
    .loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .message-actions {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        display: none;
        gap: 8px;
    }

    .message-wrapper.sent:hover .message-actions {
        display: flex;
    }

    .message-action {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: none;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .message-action:hover {
        background: rgba(255, 255, 255, 0.3);
    }
</style>
<body>
    {% include 'components/navbarClient.html.twig' %}

    <div class="messages-container">
        <!-- Conversations Sidebar -->
        <div class="conversations">
            <!-- User Profile Header -->
            <div class="user-profile-header">
                {% if user %}
                    {% if user.images is not empty %}
                        <img src="{{ '/uploads/' ~ user.images }}" alt="Profile" class="user-avatar-large">
                    {% else %}
                        <div class="user-avatar-large">
                            {{ user.username ? user.username|slice(0,1)|upper : 'U' }}
                        </div>
                    {% endif %}
                    <div class="user-name">{{ user.username }}</div>
                    <div class="user-status">
                        <div class="status-indicator"></div>
                        En ligne
                    </div>
                {% endif %}
            </div>

            <!-- Search Section -->
            <div class="search-section">
                <div class="search-input-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" id="conversationSearch" placeholder="Rechercher un vendeur...">
                </div>
            </div>

            <!-- Conversations List -->
            <div class="conversations-list" id="conversationsList">
                {% if followedSellers is defined and followedSellers|length > 0 %}
                    {% for seller in followedSellers %}
                        <div class="conversation-item" data-seller-id="{{ seller.id }}" data-unread="0">
                            {% if seller.images %}
                                <img src="{{ '/uploads/' ~ seller.images }}" alt="Avatar" class="conversation-avatar">
                            {% else %}
                                <div class="conversation-avatar">
                                    {{ seller.username ? seller.username|slice(0,1)|upper : 'U' }}
                                </div>
                            {% endif %}
                            <div class="conversation-content">
                                <div class="conversation-name">{{ seller.username }}</div>
                                <div class="conversation-preview">Cliquez pour démarrer la conversation</div>
                            </div>
                            <div class="conversation-time">Maintenant</div>
                            <span class="unread-badge" style="display: none;">0</span>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="no-conversation">
                        <i class="fas fa-comments no-conversation-icon"></i>
                        <div class="no-conversation-text">Aucune conversation</div>
                        <div class="no-conversation-subtext">Suivez des vendeurs pour commencer à discuter</div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Chat Container -->
        <div class="chat-container" id="chatContainer">
            <div class="no-conversation" id="noConversationView">
                <i class="fas fa-comments no-conversation-icon"></i>
                <div class="no-conversation-text">Sélectionnez une conversation</div>
                <div class="no-conversation-subtext">Choisissez un vendeur pour commencer à discuter</div>
            </div>

            <div class="chat-content" id="chatContent" style="display: none; flex-direction: column; height: 100%;">
                <!-- Chat Header (dynamic) -->
                <div class="chat-header" id="chatHeader">
                    <div class="chat-avatar" id="chatAvatar"></div>
                    <div class="chat-user-info">
                        <div class="chat-user-name" id="chatUserName">Sélectionnez un vendeur</div>
                        <div class="chat-user-status">
                            <div class="status-indicator"></div>
                            <span id="chatUserStatus">En ligne</span>
                        </div>
                    </div>
                    {# <div class="chat-actions">
                        <button class="chat-action-btn" title="Appeler">
                            <i class="fas fa-phone"></i>
                        </button>
                        <button class="chat-action-btn" title="Appel vidéo">
                            <i class="fas fa-video"></i>
                        </button>
                        <button class="chat-action-btn" title="Infos">
                            <i class="fas fa-info-circle"></i>
                        </button>
                    </div> #}
                </div>

                <!-- Messages Area -->
                <div class="messages-area" id="messagesArea"></div>

                <!-- Input Section -->
                <div class="input-section">
                    <div class="input-wrapper">
                        <div class="input-actions-left">
                            <button class="input-action" id="emojiButton" title="Emojis">
                                <i class="far fa-smile"></i>
                            </button>
                            <div class="emoji-picker" id="emojiPicker">
                                <span class="emoji-button" data-emoji="😀">😀</span>
                                <span class="emoji-button" data-emoji="😂">😂</span>
                                <span class="emoji-button" data-emoji="😍">😍</span>
                                <span class="emoji-button" data-emoji="👍">👍</span>
                                <span class="emoji-button" data-emoji="❤️">❤️</span>
                                <span class="emoji-button" data-emoji="😢">😢</span>
                                <span class="emoji-button" data-emoji="😴">😴</span>
                                <span class="emoji-button" data-emoji="🎉">🎉</span>
                                <span class="emoji-button" data-emoji="👋">👋</span>
                                <span class="emoji-button" data-emoji="🌟">🌟</span>
                            </div>
                            <button class="input-action" title="Pièces jointes">
                                <i class="fas fa-paperclip"></i>
                            </button>
                            <input type="file" id="fileUpload" style="display: none;" accept="image/*,video/*,.pdf">
                        </div>
                        <textarea class="message-input" id="messageInput" placeholder="Tapez votre message..." rows="1"></textarea>
                        <div class="input-actions-right">
                            <button class="send-button" id="sendButton" disabled>
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const conversationsList = document.getElementById('conversationsList');
    const conversationItems = document.querySelectorAll('.conversation-item');
    const chatContainer = document.getElementById('chatContainer');
    const noConversationView = document.getElementById('noConversationView');
    const chatContent = document.getElementById('chatContent');
    const messagesArea = document.getElementById('messagesArea');
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');
    const conversationSearch = document.getElementById('conversationSearch');
    const fileUpload = document.getElementById('fileUpload');
    const emojiButton = document.getElementById('emojiButton');
    const emojiPicker = document.getElementById('emojiPicker');
    let currentSellerId = null;
    let isTyping = false;
    const messagesBySeller = new Map(); // Simulation: Map<sellerId, messages[]>

    // Dark Mode
    const userThemeKey = 'site_theme';
    const savedTheme = localStorage.getItem(userThemeKey);
    if (savedTheme === 'dark') {
        document.body.classList.add('dark-mode');
    }

    // Auto-resize textarea
    messageInput.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 100) + 'px';
        sendButton.disabled = this.value.trim() === '';
    });

    // Search conversations
    if (conversationSearch) {
        conversationSearch.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            conversationItems.forEach(item => {
                const name = item.querySelector('.conversation-name').textContent.toLowerCase();
                item.style.display = name.includes(query) ? 'flex' : 'none';
            });
        });
    }

    // Select conversation
    conversationItems.forEach(item => {
        item.addEventListener('click', function() {
            conversationItems.forEach(i => i.classList.remove('active'));
            this.classList.add('active');
            currentSellerId = this.dataset.sellerId;
            loadMessages(currentSellerId);
            noConversationView.style.display = 'none';
            chatContent.style.display = 'flex';
            // Update header
            const name = this.querySelector('.conversation-name').textContent;
            const avatar = this.querySelector('.conversation-avatar img') ? this.querySelector('.conversation-avatar img').src : null;
            document.getElementById('chatUserName').textContent = name;
            const chatAvatar = document.getElementById('chatAvatar');
            if (avatar) {
                chatAvatar.innerHTML = `<img src="${avatar}" alt="Avatar" class="chat-avatar">`;
            } else {
                const initial = name.slice(0, 1).toUpperCase();
                chatAvatar.innerHTML = `<div class="chat-avatar" style="background: var(--primary); color: white; font-size: 1.5rem; font-weight: 600;">${initial}</div>`;
            }
        });
    });

    // Load messages for a seller (simulation)
    function loadMessages(sellerId) {
        if (!sellerId) return;
        messagesArea.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--text-secondary);"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; margin-bottom: 16px; display: block;"></i><p>Chargement des messages...</p></div>';

        // Simulate delay
        setTimeout(() => {
            const messages = messagesBySeller.get(sellerId) || [];
            displayMessages(messages);
            messagesArea.scrollTop = messagesArea.scrollHeight;
            updateUnreadCount(sellerId, 0);
        }, 500);
    }

    // Display messages
    function displayMessages(messages) {
        messagesArea.innerHTML = '';
        messages.forEach(msg => {
            const wrapper = document.createElement('div');
            wrapper.className = `message-wrapper ${msg.isSent ? 'sent' : 'received'}`;
            wrapper.dataset.messageId = msg.id;
            const bubble = document.createElement('div');
            bubble.className = `message-bubble ${msg.isSent ? 'sent' : 'received'}`;
            const content = document.createElement('div');
            content.className = 'message-content';
            content.textContent = msg.content;
            const meta = document.createElement('div');
            meta.className = 'message-meta';
            const time = document.createElement('span');
            time.className = `message-time ${msg.isSent ? 'sent' : ''}`;
            time.textContent = new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            meta.appendChild(time);
            if (msg.isSent) {
                const actions = document.createElement('div');
                actions.className = 'message-actions';
                actions.innerHTML = `
                    <button class="message-action edit-message" title="Modifier" data-message-id="${msg.id}">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="message-action delete-message" title="Supprimer" data-message-id="${msg.id}">
                        <i class="fas fa-trash"></i>
                    </button>
                `;
                wrapper.appendChild(actions);
                const status = document.createElement('div');
                status.className = 'message-status';
                status.innerHTML = `<i class="fas ${msg.isRead ? 'fa-check-double' : 'fa-check'} status-icon"></i> ${msg.isRead ? 'Lu' : 'Envoyé'}`;
                meta.appendChild(status);
            }
            if (msg.edited) {
                content.innerHTML += ' <span style="font-style: italic; opacity: 0.6;">(modifié)</span>';
            }
            bubble.appendChild(content);
            bubble.appendChild(meta);
            wrapper.appendChild(bubble);
            messagesArea.appendChild(wrapper);
        });

        // Add event listeners for edit and delete buttons
        messagesArea.querySelectorAll('.edit-message').forEach(btn => {
            btn.addEventListener('click', function() {
                const messageId = this.dataset.messageId;
                const messageWrapper = messagesArea.querySelector(`[data-message-id="${messageId}"]`);
                const content = messageWrapper.querySelector('.message-content').firstChild.textContent;
                const newContent = prompt('Modifier le message:', content);
                if (newContent && newContent.trim() !== '' && newContent !== content) {
                    editMessage(messageId, newContent);
                }
            });
        });

        messagesArea.querySelectorAll('.delete-message').forEach(btn => {
            btn.addEventListener('click', function() {
                const messageId = this.dataset.messageId;
                if (confirm('Voulez-vous vraiment supprimer ce message ?')) {
                    deleteMessage(messageId);
                }
            });
        });
    }

    // Send message (simulation)
    function sendMessage() {
        const message = messageInput.value.trim();
        if (!message || !currentSellerId) return;
        
        sendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        sendButton.disabled = true;
        
        // Simulate send
        setTimeout(() => {
            let messages = messagesBySeller.get(currentSellerId) || [];
            const messageId = Date.now().toString();
            messages.push({
                id: messageId,
                content: message,
                isSent: true,
                createdAt: new Date().toISOString(),
                isRead: false,
                edited: false
            });
            messagesBySeller.set(currentSellerId, messages);
            displayMessages(messages);
            messagesArea.scrollTop = messagesArea.scrollHeight;
            messageInput.value = '';
            messageInput.style.height = 'auto';
            sendButton.innerHTML = '<i class="fas fa-paper-plane"></i>';
            sendButton.disabled = false;
            if (isTyping) stopTyping();

            // Simulate auto-response after 1s
            setTimeout(() => {
                const autoId = (Date.now() + 1).toString();
                const autoResponse = 'Merci pour votre message! Je vous répondrai dès que possible.';
                messages.push({
                    id: autoId,
                    content: autoResponse,
                    isSent: false,
                    createdAt: new Date().toISOString(),
                    isRead: false,
                    edited: false
                });
                messagesBySeller.set(currentSellerId, messages);
                displayMessages(messages);
                messagesArea.scrollTop = messagesArea.scrollHeight;
                updateUnreadCount(currentSellerId, 1); // Simulate unread
            }, 1000);
        }, 500);
    }

    sendButton.addEventListener('click', sendMessage);
    messageInput.addEventListener('keypress', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    // Edit message (simulation)
    function editMessage(messageId, newContent) {
        let messages = messagesBySeller.get(currentSellerId) || [];
        const msg = messages.find(m => m.id === messageId);
        if (msg && msg.isSent) {
            msg.content = newContent;
            msg.edited = true;
            messagesBySeller.set(currentSellerId, messages);
            displayMessages(messages);
        }
    }

    // Delete message (simulation)
    function deleteMessage(messageId) {
        let messages = messagesBySeller.get(currentSellerId) || [];
        messages = messages.filter(m => m.id !== messageId);
        messagesBySeller.set(currentSellerId, messages);
        displayMessages(messages);
    }

    // File upload (simulation)
    const paperclipBtn = document.querySelector('.input-action:has(.fa-paperclip)');
    if (paperclipBtn) {
        paperclipBtn.addEventListener('click', () => fileUpload.click());
    }
    fileUpload.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const message = `Fichier envoyé: ${file.name}`;
            messageInput.value = message;
            sendMessage();
        }
    });

    // Typing indicator
    let typingTimeout;
    messageInput.addEventListener('input', function() {
        if (currentSellerId && !isTyping) {
            isTyping = true;
            showTypingIndicator();
        }
        clearTimeout(typingTimeout);
        typingTimeout = setTimeout(() => {
            stopTyping();
        }, 1000);
    });

    function showTypingIndicator() {
        const indicator = document.createElement('div');
        indicator.className = 'typing-indicator';
        indicator.innerHTML = '<div class="typing-dots"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div> <span>L\'interlocuteur écrit...</span>';
        messagesArea.appendChild(indicator);
        messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    function stopTyping() {
        isTyping = false;
        const indicator = messagesArea.querySelector('.typing-indicator');
        if (indicator) indicator.remove();
    }

    // Update unread count (simulation)
    function updateUnreadCount(sellerId, count) {
        const item = document.querySelector(`[data-seller-id="${sellerId}"]`);
        if (item) {
            const badge = item.querySelector('.unread-badge');
            badge.textContent = count;
            badge.style.display = count > 0 ? 'inline-block' : 'none';
            item.dataset.unread = count;
        }
    }

    // Emoji functionality
    emojiButton.addEventListener('click', function() {
        emojiPicker.classList.toggle('active');
    });

    document.querySelectorAll('.emoji-button').forEach(button => {
        button.addEventListener('click', function() {
            const emoji = this.getAttribute('data-emoji');
            messageInput.value += emoji;
            messageInput.style.height = 'auto';
            messageInput.style.height = Math.min(messageInput.scrollHeight, 100) + 'px';
            sendButton.disabled = messageInput.value.trim() === '';
            emojiPicker.classList.remove('active');
        });
    });

    // Close emoji picker when clicking outside
    document.addEventListener('click', function(event) {
        if (!emojiButton.contains(event.target) && !emojiPicker.contains(event.target)) {
            emojiPicker.classList.remove('active');
        }
    });
});
</script>
</body>
</html>