{% extends 'admin/baseAdmin.html.twig' %}

{% block title %}Création de Live{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/live_form.css') }}">
{% endblock %}

{% block content %}
    <main class="live-creator-container">
        <div class="promotion-header">
            <h2>
                <i class="fas fa-broadcast-tower"></i>
                <span data-i18n="create_live">Créer un Live Shopping</span>
            </h2>
        </div>

        <form action="{{ path('admin_live_confirm') }}" method="post" class="live-form">
            <section class="form-section">
                <div class="section-header">
                    <h2 class="section-title" data-i18n="live_information">Informations du Live</h2>
                    <div class="section-badge">Obligatoire</div>
                </div>

                <div class="form-group">
                    <label for="titre" class="form-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                        </svg>
                        <span data-i18n="live_title">Titre du live</span>
                    </label>
                    <input type="text" name="titre" id="titre" class="form-input" placeholder="Ex: Collection Printemps - Découverte exclusive" data-i18n-placeholder="live_title" required>
                </div>

                <div class="form-group">
                    <label for="description" class="form-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span data-i18n="live_description">Description du live</span>
                    </label>
                    <textarea name="description" id="description" class="form-input form-textarea" placeholder="Décrivez votre live shopping, les produits présentés, les offres spéciales..." data-i18n-placeholder="live_description" rows="4" required></textarea>
                    <div class="char-counter"><span id="charCount">0</span>/500 caractères</div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-header">
                    <h2 class="section-title" data-i18n="products_to_highlight">Produits à mettre en avant</h2>
                    <div class="section-badge">{{ items|length }} produits</div>
                </div>

                <div class="selection-info">
                    <div class="selected-count">
                        <span id="selectedProductsCount">0</span> produit(s) sélectionné(s)
                    </div>
                    <button type="button" class="select-all-btn" id="selectAllBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span data-i18n="select_all">Tout sélectionner</span>
                    </button>
                </div>

                <div class="products-grid" id="productsGrid">
                    {% for item in items %}
                        <label class="product-card-wrapper">
                            <input type="checkbox" name="items[]" value="{{ item.id_item }}" class="product-checkbox">
                            <article class="product-card">
                                <div class="product-image-container">
                                    <img src="{{ asset('uploads/' ~ item.images) }}" alt="{{ item.nameItem }}" class="product-image" loading="lazy">
                                    <div class="product-overlay">
                                        <div class="checkbox-indicator">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    {% if item.namePromotion|length > 0 %}
                                        <div class="product-badge promo-badge">-{{ item.percentage }}%</div>
                                    {% endif %}
                                    {% if item.stock_disponible <= 10 and item.stock_disponible > 0 %}
                                        <div class="product-badge stock-badge">Stock faible</div>
                                    {% elseif item.stock_disponible == 0 %}
                                        <div class="product-badge out-of-stock-badge">Rupture</div>
                                    {% endif %}
                                </div>

                                <div class="product-info">
                                    <h3 class="product-name">{{ item.nameItem }}</h3>
                                    <div class="product-meta">
                                        <span class="product-category">{{ item.nameCategory }}</span>
                                        <span class="product-stock">{{ item.stock_disponible }} en stock</span>
                                    </div>
                                    <div class="product-pricing">
                                        {% if item.namePromotion|length > 0 %}
                                            <span class="product-price-original">{{ item.prix|number_format(2, '.', ' ') }} €</span>
                                            <span class="product-price-discounted">
                                                {{ (item.prix * (1 - item.percentage/100))|number_format(2, '.', ' ') }} €
                                            </span>
                                        {% else %}
                                            <span class="product-price">{{ item.prix|number_format(2, '.', ' ') }} €</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>
                        </label>
                    {% else %}
                        <div class="no-products-message">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <h3 data-i18n="no_products">Aucun produit disponible</h3>
                            <p data-i18n="no_products_description">Ajoutez des produits à votre catalogue pour les sélectionner dans vos lives.</p>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <div class="form-footer">
                <div class="form-warning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    <div>
                        <strong data-i18n="form_warning_title">Attention</strong>
                        <span data-i18n="form_warning">Tous les champs sont obligatoires. Le live sera visible immédiatement après validation.</span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-secondary" data-i18n="cancel">Annuler</button>
                    <button type="submit" class="submit-btn" id="submitBtn" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="23 7 16 12 23 17 23 7"></polygon>
                            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                        </svg>
                        <span data-i18n="launch_live_shopping">Lancer le Live Shopping</span>
                        <div class="loading-spinner" id="submitSpinner"></div>
                    </button>
                </div>
            </div>
        </form>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Compteur de caractères pour la description
            const descriptionTextarea = document.getElementById('description');
            const charCount = document.getElementById('charCount');

            descriptionTextarea.addEventListener('input', function() {
                const count = this.value.length;
                charCount.textContent = count;

                if (count > 500) {
                    charCount.style.color = '#ef4444';
                } else if (count > 400) {
                    charCount.style.color = '#f59e0b';
                } else {
                    charCount.style.color = 'var(--gray-600)';
                }
            });

            // Gestion de la sélection des produits
            const checkboxes = document.querySelectorAll('.product-checkbox');
            const selectedCount = document.getElementById('selectedProductsCount');
            const selectAllBtn = document.getElementById('selectAllBtn');
            const submitBtn = document.getElementById('submitBtn');

            function updateSelectionCount() {
                const selected = document.querySelectorAll('.product-checkbox:checked').length;
                selectedCount.textContent = selected;

                // Activer/désactiver le bouton de soumission
                submitBtn.disabled = selected === 0;

                // Mettre à jour le texte du bouton "Tout sélectionner"
                if (selected === checkboxes.length) {
                    selectAllBtn.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        </svg>
                        <span data-i18n="deselect_all">Tout désélectionner</span>
                    `;
                } else {
                    selectAllBtn.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span data-i18n="select_all">Tout sélectionner</span>
                    `;
                }
            }

            // Sélectionner/désélectionner tous les produits
            selectAllBtn.addEventListener('click', function() {
                const allSelected = document.querySelectorAll('.product-checkbox:checked').length === checkboxes.length;

                checkboxes.forEach(checkbox => {
                    checkbox.checked = !allSelected;
                    checkbox.dispatchEvent(new Event('change'));
                });
            });

            // Mettre à jour l'état visuel des cartes produits
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const card = this.closest('.product-card-wrapper');
                    if (this.checked) {
                        card.classList.add('selected');
                    } else {
                        card.classList.remove('selected');
                    }
                    updateSelectionCount();
                });
            });

            // Soumission du formulaire
            const form = document.querySelector('.live-form');
            const submitSpinner = document.getElementById('submitSpinner');

            form.addEventListener('submit', function(e) {
                const selectedProducts = document.querySelectorAll('.product-checkbox:checked').length;

                if (selectedProducts === 0) {
                    e.preventDefault();
                    alert('Veuillez sélectionner au moins un produit pour votre live.');
                    return;
                }

                // Afficher l'indicateur de chargement
                submitSpinner.style.display = 'block';
                submitBtn.disabled = true;
            });

            // Initialiser le compteur
            updateSelectionCount();
        });
    </script>
{% endblock %}
