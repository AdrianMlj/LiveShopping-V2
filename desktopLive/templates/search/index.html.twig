{% include 'components/navbarClient.html.twig' %}

<div class="container" style="max-width: 1100px; margin: 90px auto 24px; padding: 0 16px;">
  <form method="get" action="{{ path('app_search') }}" class="search-form">
    <div class="search-wrapper">
      <input type="text" name="q" value="{{ query }}" placeholder="Rechercher..." class="search-input">
      <select name="sort" class="sort-select">
        <option value="name_asc" {{ sort == 'name_asc' ? 'selected' : '' }}>Nom A→Z</option>
        <option value="name_desc" {{ sort == 'name_desc' ? 'selected' : '' }}>Nom Z→A</option>
      </select>
      <button type="submit" class="search-btn">Rechercher</button>
    </div>
  </form>

  <h3 class="section-title">Articles</h3>
  <div class="grid-container products-grid">
    {% for a in articles %}
      <div class="product-card">
        <div class="product-image">
          <img src="{{ a.image ? '/uploads/' ~ a.image : '/uploads/default-product.jpg' }}" alt="{{ a.name }}" loading="lazy">
        </div>
        <div class="product-info">
          <h4 class="product-name">{{ a.name }}</h4>
          <p class="product-price">{{ a.price is not null ? (a.price ~ ' Ar') : '—' }}</p>
          <div class="product-actions">
            <button class="fav-btn" data-id="{{ a.id }}" title="Ajouter aux favoris">
              <i class="far fa-bookmark"></i>
            </button>
            <form method="post" action="{{ path('app_client_add_cart', { id: a.id }) }}" class="cart-form">
              <input type="hidden" name="name" value="{{ a.name }}">
              <input type="hidden" name="price" value="{{ a.price }}">
              <input type="hidden" name="images" value="{{ a.image }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="cart-btn" title="Ajouter au panier">
                <i class="fas fa-shopping-basket"></i> Panier
              </button>
            </form>
          </div>
        </div>
      </div>
    {% else %}
      <div class="no-results">Aucun article.</div>
    {% endfor %}
  </div>

  <h3 class="section-title">Vendeurs</h3>
  <div class="grid-container sellers-grid">
    {% for s in sellers %}
      <div class="seller-card">
        <div class="seller-avatar">
          {% if s.images %}
            <img src="{{ '/uploads/' ~ s.images }}" alt="{{ s.username }}" loading="lazy">
          {% else %}
            <div class="avatar-initial">{{ s.username ? s.username|first|upper : 'U' }}</div>
          {% endif %}
        </div>
        <div class="seller-info">
          <h4 class="seller-name">{{ s.username }}</h4>
          <button type="button" class="btn-follow" data-seller-id="{{ s.id }}" style="background: {{ s.following ? '#22c55e' : '#ff2d55' }};">
            {{ s.following ? 'Following' : 'Follow' }}
          </button>
        </div>
      </div>
    {% else %}
      <div class="no-results">Aucun vendeur.</div>
    {% endfor %}
  </div>

  <h3 class="section-title">Lives</h3>
  <div class="grid-container lives-grid">
    {% for l in lives %}
      <div class="live-card">
        <div class="live-avatar">
          {% if l.seller and l.seller.images %}
            <img src="{{ '/uploads/' ~ l.seller.images }}" alt="{{ l.seller.username }}" loading="lazy">
          {% else %}
            <div class="avatar-initial">{{ l.seller and l.seller.username ? l.seller.username|first|upper : 'U' }}</div>
          {% endif %}
        </div>
        <div class="live-info">
          <h4 class="live-name">{{ l.seller ? l.seller.username : 'Live' }}</h4>
          <p class="live-status" style="color: {{ l.isLive ? '#22c55e' : '#888' }}">{{ l.isLive ? 'En cours' : 'Terminé' }}</p>
        </div>
        {% if l.seller %}
          <a href="{{ path('app_client_live', { id: l.id }) }}" class="view-btn">Voir</a>
        {% endif %}
      </div>
    {% else %}
      <div class="no-results">Aucun live.</div>
    {% endfor %}
  </div>
</div>

<style>
  :root {
    --primary: #567AF4;
    --success: #22c55e;
    --danger: #ff2d55;
    --gray-light: #eee;
    --text-dark: #2d3748;
    --text-gray: #888;
    --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    --transition: all 0.3s ease;
  }

  .container {
    animation: fadeIn 0.5s ease-out;
  }

  .search-form {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    animation: slideDown 0.5s ease-out;
  }

  .search-wrapper {
    display: flex;
    width: 100%;
    gap: 8px;
  }

  .search-input, .sort-select {
    flex: 1;
    padding: 12px;
    border: 1px solid var(--gray-light);
    border-radius: 8px;
    font-size: 1rem;
    transition: var(--transition);
  }

  .search-input:focus, .sort-select:focus {
    border-color: var(--primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(86, 122, 244, 0.2);
  }

  .search-btn {
    padding: 12px 20px;
    border: none;
    background: var(--primary);
    color: #fff;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
  }

  .search-btn:hover {
    background: #4a6be6; /* Darker shade of primary */
    transform: translateY(-2px);
  }

  .section-title {
    margin: 24px 0 12px;
    font-size: 1.5rem;
    color: var(--text-dark);
    animation: fadeInUp 0.5s ease-out;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .product-card, .seller-card, .live-card {
    background: #fff;
    border: 1px solid var(--gray-light);
    border-radius: 10px;
    padding: 12px;
    transition: var(--transition);
    box-shadow: var(--shadow);
    animation: cardPop 0.5s ease-out;
  }

  .product-card:hover, .seller-card:hover, .live-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  }

  .product-image img, .seller-avatar img, .live-avatar img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    transition: var(--transition);
  }

  .product-image img:hover {
    opacity: 0.9;
  }

  .product-info, .seller-info, .live-info {
    margin-top: 12px;
  }

  .product-name, .seller-name, .live-name {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-dark);
  }

  .product-price {
    color: var(--text-gray);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .product-actions, .live-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fav-btn, .cart-btn, .view-btn, .btn-follow {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
  }

  .fav-btn {
    background: none;
    color: #FFD600;
  }

  .fav-btn:hover i {
    color: #d9b200; /* Darker shade of yellow */
    transform: scale(1.1);
  }

  .fav-btn i.fas {
    color: #FFD600;
  }

  .cart-btn {
    background: var(--primary);
    color: #fff;
  }

  .cart-btn:hover {
    background: #4a6be6; /* Darker shade of primary */
    transform: translateY(-2px);
  }

  .view-btn {
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    padding: 8px 12px;
  }

  .view-btn:hover {
    background: #4a6be6; /* Darker shade of primary */
    transform: translateY(-2px);
  }

  .btn-follow {
    padding: 6px 12px;
    color: #fff;
    transition: var(--transition);
  }

  .btn-follow:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .seller-avatar, .live-avatar {
    position: relative;
  }

  .avatar-initial {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 1.2rem;
  }

  .live-status {
    font-size: 0.9rem;
    margin-top: 4px;
  }

  .no-results {
    text-align: center;
    color: var(--text-gray);
    padding: 20px;
    animation: fadeIn 0.5s ease-out;
  }

  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes cardPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .search-form {
      flex-direction: column;
      gap: 12px;
    }

    .search-wrapper {
      flex-direction: column;
      width: 100%;
    }

    .search-input, .sort-select, .search-btn {
      width: 100%;
    }

    .grid-container {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }

    .product-image img {
      height: 120px;
    }
  }

  @media (max-width: 480px) {
    .container {
      margin-top: 60px;
    }

    .section-title {
      font-size: 1.2rem;
    }

    .product-actions {
      flex-direction: column;
      gap: 8px;
    }

    .fav-btn, .cart-btn {
      width: 100%;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
  // Favoris sur page de recherche
  document.querySelectorAll('.fav-btn').forEach(btn => {
    btn.addEventListener('click', function(e){
      e.preventDefault();
      const itemId = this.dataset.id;
      fetch(`/client/favorite/toggle-all-sizes/${itemId}`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }})
        .then(res => { if(!res.ok) throw new Error('HTTP '+res.status); return res.json(); })
        .then(data => {
          if (!data.success) return;
          const icon = this.querySelector('i');
          icon.classList.toggle('fas');
          icon.classList.toggle('far');
          this.setAttribute('title', icon.classList.contains('fas') ? 'Retirer des favoris' : 'Ajouter aux favoris');
        })
        .catch(console.error);
    });
  });

  document.querySelectorAll('.btn-follow').forEach(btn => {
    btn.addEventListener('click', function(){
      const sellerId = this.dataset.sellerId;
      fetch(`/client/follow/toggle/${sellerId}`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }})
        .then(res => { if(!res.ok) throw new Error('HTTP '+res.status); return res.json(); })
        .then(data => {
          if (!data.success) return;
          if (data.action === 'followed') {
            this.textContent = 'Following';
            this.style.background = '#22c55e';
          } else if (data.action === 'unfollowed') {
            this.textContent = 'Follow';
            this.style.background = '#ff2d55';
          }
        })
        .catch(console.error);
    });
  });
});
</script>