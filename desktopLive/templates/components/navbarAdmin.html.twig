        function buildReverseTranslations() {
            if (!window.translationReverse) {
                window.translationReverse = {};
            }
            Object.entries(translations).forEach(([lang, dict]) => {
                const reverse = {};
                Object.entries(dict).forEach(([key, value]) => {
                    if (typeof value === 'string') {
                        reverse[value] = key;
                    }
                });
                window.translationReverse[lang] = reverse;
            });
        }

        buildReverseTranslations();

        function getTranslationKeyByValue(value, lang) {
            if (!value) return null;
            const language = lang || (window.currentLanguage || 'fr');
            const reverse = window.translationReverse ? window.translationReverse[language] : null;
            if (!reverse) return null;
            return reverse[value] || null;
        }

        window.getTranslationKeyByValue = getTranslationKeyByValue;

        function setLanguage(lang) {
            localStorage.setItem('site_language', lang);
            window.currentLanguage = lang;
            const dict = translations[lang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) el.textContent = dict[key];
            });
            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (dict[key]) el.setAttribute('placeholder', dict[key]);
            });
            if (typeof window.applyColorTranslations === 'function') {
                window.applyColorTranslations();
            }
            if (typeof window.applySizeTranslations === 'function') {
                window.applySizeTranslations();
            }
            if (typeof window.translateCategoryLegend === 'function') {
                window.translateCategoryLegend();
            }
            if (typeof window.translateRankingArticles === 'function') {
                window.translateRankingArticles();
            }
        }

        // Global translation function for alerts and popups
        window.t = function(key, fallback = '') {
            const lang = localStorage.getItem('site_language') || 'en';
            return translations[lang]?.[key] || fallback || key;
        };

        // Set language from localStorage or default to English
        const savedLang = localStorage.getItem('site_language');
        const userSetLang = localStorage.getItem('site_language_user_set') === '1';
        const domLang = (document.documentElement && document.documentElement.getAttribute('lang')) || 'fr';
        const initialLang = (userSetLang && savedLang) ? savedLang : domLang || 'fr';
        setLanguage(initialLang);

        // Flag click event
        document.querySelectorAll('.lang-flag').forEach(flag => {
            flag.addEventListener('click', () => {
                const lang = flag.getAttribute('data-lang');
                setLanguage(lang);
                localStorage.setItem('site_language_user_set', '1');
            });
        });
    });
</script>
