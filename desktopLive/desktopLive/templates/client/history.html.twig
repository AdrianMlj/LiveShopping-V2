{% include 'components/navbarClient.html.twig' %}

{% block content %}
<div class="historique-container">
  <div class="historique-filter-card">
    <form method="get" class="historique-filter-grid">
      <div class="historique-filter-group">
        <label for="date_start" class="historique-filter-label">
          <i class="fas fa-calendar-alt"></i>
          Date début
        </label>
        <input type="date" name="date_start" id="date_start" class="historique-input"
               value="{{ app.request.query.get('date_start') }}">
      </div>

      <div class="historique-filter-group">
        <label for="date_end" class="historique-filter-label">
          <i class="fas fa-calendar-alt"></i>
          Date fin
        </label>
        <input type="date" name="date_end" id="date_end" class="historique-input"
               value="{{ app.request.query.get('date_end') }}">
      </div>

      <div class="historique-filter-group">
        <label for="state" class="historique-filter-label">
          <i class="fas fa-tag"></i>
          État commande
        </label>
        <select name="state" id="state" class="historique-input">
          <option value="">-- Tous --</option>
          {% for state in states %}
            <option value="{{ state.id }}" {{ app.request.query.get('state') == state.id ? 'selected' }}>
              {{ state.nameState }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="historique-filter-group">
        <label for="is_paid" class="historique-filter-label">
          <i class="fas fa-credit-card"></i>
          Paiement
        </label>
        <select name="is_paid" id="is_paid" class="historique-input">
          <option value="">-- Tous --</option>
          <option value="1" {{ app.request.query.get('is_paid') == '1' ? 'selected' }}>Payé</option>
          <option value="0" {{ app.request.query.get('is_paid') == '0' ? 'selected' }}>Non payé</option>
        </select>
      </div>

      <div class="historique-filter-actions">
        <button type="submit" class="historique-button">
          <i class="fas fa-search"></i>
          Filtrer
        </button>
      </div>
    </form>
  </div>

  <div class="historique-table-section">
    <div class="historique-table-header">
      <h3 class="historique-table-title">
        <i class="fas fa-receipt"></i>
        Historique de mes achats
      </h3>
    </div>

    <div class="historique-table-container">
      <table class="historique-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Vendeur</th>
            <th>État</th>
            <th>Montant total</th>
            <th>Paiement</th>
          </tr>
        </thead>
        <tbody>
          {% for sale in sales %}
            {% set total = 0 %}
            {% for detail in sale.commande.details %}
              {% set total = total + (detail.quantity * detail.price) %}
            {% endfor %}

            <tr class="clickable-row" data-sale-id="{{ sale.id }}">
              <td>{{ sale.saleDate|date('d/m/Y H:i') }}</td>
              <td>{{ sale.commande.seller ? sale.commande.seller.getUsername() : '-' }}</td>
              <td>{{ sale.commande.state.nameState }}</td>
              <td class="historique-amount">{{ total|number_format(2, ',', ' ') }} €</td>
              <td>
                {% if sale.isPaid %}
                  <span class="historique-badge historique-badge-success">Payé</span>
                {% else %}
                  <span class="historique-badge historique-badge-danger">Non payé</span>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="historique-empty">Achat introuvable.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="saleDetailsModal" class="custom-modal" style="display: none;">
  <div class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h5>Détails de l'achat</h5>
        <button type="button" id="exportPDF" class="export-btn">Télécharger la facture</button>
        <button type="button" class="close-btn" id="closeModal">&times;</button>
      </div>
      <div class="modal-body" id="saleDetailsContent"></div>
    </div>
  </div>
  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('saleDetailsModal');
  const closeBtn = document.getElementById('closeModal');
  const modalContent = document.getElementById('saleDetailsContent');
  let currentSaleId = null;

  function openModal() {
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
    modal.classList.remove('closing');
  }
  function closeModal() {
    modal.classList.add('closing');
    setTimeout(() => {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
      modal.classList.remove('closing');
    }, 200);
  }
  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'block') closeModal(); });

  document.querySelectorAll('.clickable-row').forEach(row => {
    row.addEventListener('click', () => {
      const saleId = row.dataset.saleId;
      currentSaleId = saleId;
      fetch(`/client/history/details?sale_id=${saleId}`)
        .then(r => r.json())
        .then(data => {
          if (data.html) { modalContent.innerHTML = data.html; openModal(); }
          else if (data.error) { alert(data.error); }
        })
        .catch(() => alert('Erreur de chargement'));
    });
  });

  document.getElementById('exportPDF').addEventListener('click', () => {
    try {
      if (typeof window.jspdf === 'undefined' && typeof window.jsPDF === 'undefined') {
        alert("La bibliothèque PDF n'est pas chargée.");
        return;
      }
      const jsPDF = window.jspdf ? window.jspdf.jsPDF : window.jsPDF;
      if (!modalContent.innerHTML || !currentSaleId) {
        alert('Sélectionnez d\'abord un achat.');
        return;
      }
      const doc = new jsPDF();
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = modalContent.innerHTML;
      const rows = tempDiv.querySelectorAll('.invoice-table tbody tr');
      let y = 20;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(16);
      doc.text('Facture', 20, y); y += 10;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      rows.forEach((r) => {
        const c = r.querySelectorAll('td');
        if (c.length >= 5) {
          doc.text(`${c[0].textContent}  ${c[1].textContent}  x${c[2].textContent}  ${c[3].textContent}  ${c[4].textContent}`, 20, y);
          y += 6;
        }
      });
      doc.save(`Facture_${currentSaleId}.pdf`);
    } catch (e) {
      alert('Erreur PDF');
    }
  });
});
</script>
{% endblock %}

<style>
/* Reuse admin history styles */
@import url('/css/historique.css');
