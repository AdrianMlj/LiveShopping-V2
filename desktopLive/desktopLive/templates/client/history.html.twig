<div id="saleDetailsModal" class="custom-modal" style="display:none;">
  <div class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h5>Détails de l'achat</h5>
        <div>
          <button type="button" id="markPaidBtn" class="export-btn" style="margin-right:8px; background:linear-gradient(135deg,#10b981,#059669)">Marquer payé (livreur)</button>
          <button type="button" id="exportPDF" class="export-btn">Télécharger la facture</button>
          <button type="button" class="close-btn" id="closeModal">&times;</button>
        </div>
      </div>
      <div class="modal-body" id="saleDetailsContent"></div>
    </div>
  </div>
</div>

<script>
let currentSaleId = null;

document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('saleDetailsModal');
  const closeBtn = document.getElementById('closeModal');
  const modalContent = document.getElementById('saleDetailsContent');
  const markPaidBtn = document.getElementById('markPaidBtn');

  function openModal(){ modal.style.display='block'; document.body.style.overflow='hidden'; modal.classList.remove('closing'); }
  function closeModal(){ modal.classList.add('closing'); setTimeout(()=>{ modal.style.display='none'; document.body.style.overflow='auto'; modal.classList.remove('closing'); },200); }

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e)=>{ if(e.target===modal){ closeModal(); } });
  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape' && modal.style.display==='block'){ closeModal(); } });

  document.querySelectorAll('.clickable-row').forEach(row=>{
    row.addEventListener('click', ()=>{
      const saleId = row.dataset.saleId; currentSaleId = saleId;
      fetch(`/client/history/details?sale_id=${saleId}`)
        .then(r=>r.json())
        .then(data=>{ if(data.html){ modalContent.innerHTML = data.html; openModal(); } else if(data.error){ alert(data.error); } })
        .catch(()=> alert('Erreur lors du chargement des détails'));
    });
  });

  markPaidBtn.addEventListener('click', async ()=>{
    if(!currentSaleId){ alert('Sélectionnez une commande'); return; }
    if(!confirm('Confirmer le paiement au livreur ?')) return;
    const formData = new FormData();
    formData.append('sale_id', currentSaleId);
    const res = await fetch('/client/history/mark-paid', { method:'POST', body: formData });
    const data = await res.json();
    if(data && data.success){
      alert('Paiement confirmé. Merci !');
      location.reload();
    } else {
      alert(data.error || 'Erreur lors de la confirmation');
    }
  });

  document.getElementById('exportPDF').addEventListener('click', () => {
    try {
      if (typeof window.jspdf === 'undefined' && typeof window.jsPDF === 'undefined') {
        alert('La bibliothèque PDF n\'est pas chargée.');
        return;
      }
      const jsPDF = window.jspdf ? window.jspdf.jsPDF : window.jsPDF;
      if (!modalContent.innerHTML || !currentSaleId) {
        alert('Veuillez sélectionner une commande.');
        return;
      }
      const doc = new jsPDF();
      const modalHTML = modalContent.innerHTML;
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = modalHTML;

      doc.setFillColor(41,128,185); doc.rect(0,0,210,40,'F');
      doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(24);
      doc.text('LIVE SHOP', 105, 15, { align:'center' });
      doc.setFontSize(14); doc.text('FACTURE', 105, 25, { align:'center' });
      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.text(`N° ${currentSaleId}`, 105, 32, { align:'center' });

      const clientInfo = tempDiv.querySelector('.client');
      const sellerInfo = tempDiv.querySelector('.seller');
      const statusInfo = tempDiv.querySelector('.invoice-status');
      const tableRows = tempDiv.querySelectorAll('.invoice-table tbody tr');

      let yPos = 70;
      if (clientInfo && sellerInfo) {
        doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.text('FACTURÉ À', 20, yPos);
        doc.setFont('helvetica','normal'); doc.setFontSize(9);
        const clientLines = doc.splitTextToSize(clientInfo.textContent.replace(/\s+/g,' ').trim(), 80);
        doc.text(clientLines, 20, yPos+8);
        doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.text('VENDU PAR', 110, yPos);
        doc.setFont('helvetica','normal'); doc.setFontSize(9);
        const sellerLines = doc.splitTextToSize(sellerInfo.textContent.replace(/\s+/g,' ').trim(), 80);
        doc.text(sellerLines, 110, yPos+8);
        yPos += Math.max(clientLines.length, sellerLines.length) * 5 + 15;
      }

      if (statusInfo) {
        doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.text('STATUT:', 20, yPos);
        doc.setFont('helvetica','normal'); doc.setFontSize(9);
        const statusText = statusInfo.textContent.replace(/\s+/g,' ').trim();
        doc.text(statusText, 50, yPos); yPos += 15;
      }

      doc.setDrawColor(200,200,200); doc.setLineWidth(0.5); doc.line(20, yPos, 190, yPos); yPos += 10;

      if (tableRows.length > 0) {
        doc.setFillColor(248,249,250); doc.rect(20, yPos - 5, 170, 8, 'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(9);
        doc.text('PRODUIT', 22, yPos); doc.text('TAILLE', 70, yPos); doc.text('QTÉ', 100, yPos); doc.text('PRIX UNIT.', 120, yPos); doc.text('TOTAL', 160, yPos);
        yPos += 10; doc.setDrawColor(200,200,200); doc.line(20, yPos - 2, 190, yPos - 2);

        doc.setFont('helvetica','normal'); doc.setFontSize(8);
        tableRows.forEach((row, index) => {
          const cells = row.querySelectorAll('td');
          if (cells.length >= 5) {
            if (index % 2 === 0) { doc.setFillColor(250,250,250); doc.rect(20, yPos - 3, 170, 6, 'F'); }
            doc.text(cells[0].textContent.trim(), 22, yPos);
            doc.text(cells[1].textContent.trim(), 70, yPos);
            doc.text(cells[2].textContent.trim(), 100, yPos);
            doc.text(cells[3].textContent.trim(), 120, yPos);
            doc.text(cells[4].textContent.trim(), 160, yPos);
            yPos += 7;
          }
        });
        yPos += 10;

        let totalHT = 0; tableRows.forEach((row)=>{
          const c = row.querySelectorAll('td');
          if (c.length >= 5) {
            const q = parseFloat(c[2].textContent.trim()) || 0;
            const p = parseFloat(c[3].textContent.replace(/[€\s,]/g,'').replace(',', '.')) || 0;
            totalHT += q * p;
          }
        });
        doc.setFont('helvetica','normal'); doc.setFontSize(10);
        doc.text(`Sous-total HT: ${totalHT.toFixed(2).replace('.', ',')} €`, 120, yPos); yPos += 8;
        const tva = totalHT * 0.2; doc.text(`TVA (20%): ${tva.toFixed(2).replace('.', ',')} €`, 120, yPos); yPos += 8;
        const totalTTC = totalHT * 1.2; doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.text(`TOTAL TTC: ${totalTTC.toFixed(2).replace('.', ',')} €`, 120, yPos);
      }

      const pageCount = doc.internal.getNumberOfPages();
      for (let i = 1; i <= pageCount; i++) {
        doc.setPage(i); doc.setFillColor(240,240,240); doc.rect(0, 280, 210, 20, 'F');
        doc.setTextColor(100,100,100); doc.setFont('helvetica','normal'); doc.setFontSize(8);
        doc.text('Merci pour votre achat !', 20, 290);
        doc.text(`Page ${i} sur ${pageCount}`, 105, 290, { align:'center' });
        doc.text('LiveShop - Votre partenaire shopping', 150, 290);
      }

      doc.save(`Facture_${currentSaleId}.pdf`);
    } catch (e) {
      alert('Erreur PDF: ' + e.message);
    }
  });
});
</script>

<style>
@import url('/css/historique.css');
</style>
{% endblock %}

